@page "/"
@inject PhilanthroPoints.Services.PointsState Points
@inject NavigationManager Nav
@inject PhilanthroPoints.Services.LoginService Auth
@inject PhilanthroPoints.Services.CustomAuthStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@inject PhilanthroPoints.Services.FlowState Flow
@using PhilanthroPoints.Components

<div class="birthday-home page-enter">
    <!-- Floating decorations - will be enabled after page load for performance -->

    
    <div class="welcome-header decorative-border">
            <p class="welcome-text">Welcome to Birthday connections!</p>
      <p class="tagline">Make Every Birthday Special with Thoughtful Gifts & Treats</p>
      <div class="sparkle" style="top: 20%; left: 15%;"></div>
      <div class="sparkle" style="top: 30%; right: 20%;"></div>
      <div class="sparkle" style="bottom: 25%; left: 25%;"></div>
    </div>
    
    <AuthorizeView>
      <Authorized Context="authState">
        <p class="card">Use your points to choose gifts, sweets, and a card. Continue the flow below.</p>
        <div class="grid">
          <div class="card">
            <div class="category-icon">👤</div>
            <h3>Demographics</h3>
            <p class="card-description">Tell us about the birthday person</p>
            <button class="btn" @onclick="DemographicsClick">Open</button>
          </div>
          <div class="card">
            <div class="category-icon">💌</div>
            <h3>Birthday Cards</h3>
            <p class="card-description">Choose the perfect greeting card</p>
            <button class="btn" @onclick="CardsClick">Browse</button>
          </div>
          <div class="card">
            <div class="category-icon"></div>
            <h3>Sweets &amp; Treats</h3>
            <p class="card-description">Delicious cakes and sweet surprises</p>
            <button class="btn" @onclick="TreatsClick">Browse</button>
          </div>
          <div class="card">
            <div class="category-icon">📚</div>
            <h3>Books</h3>
            <p class="card-description">Educational and entertaining reads</p>
            <button class="btn" @onclick="BooksClick">Browse</button>
          </div>
          <div class="card">
            <div class="category-icon"></div>
            <h3>Gifts</h3>
            <p class="card-description">Thoughtful presents they'll love</p>
            <button class="btn" @onclick="GiftsClick">Browse</button>
          </div>
          <div class="card">
            <div class="category-icon">🛒</div>
            <h3>Cart</h3>
            <p class="card-description">Review your birthday selection</p>
            <button class="btn" @onclick="CartClick">View</button>
          </div>
          <AuthorizeView Roles="Admin">
            <div class="card">
              <div class="category-icon">⚙️</div>
              <h3>Admin</h3>
              <p class="card-description">Manage inventory and settings</p>
              <button class="btn" @onclick="AdminClick">Admin</button>
            </div>
          </AuthorizeView>
        </div>
  </Authorized>
      <NotAuthorized Context="na">
        <button class="btn" style="font-size: 1.2rem; padding: 1rem 2rem;" @onclick="ShowLogin">Click Here to Start</button>
        <div style="margin-top:1rem;">
          <button class="btn" @onclick="AdminClick">Admin</button>
        </div>
        @if (showLoginForm)
        {
            <div style="background-color: lightblue; padding: 20px; border-radius:8px; max-width:420px; margin: 2rem auto;">
                <h2>Login</h2>
                @if (error != null) { <p style="color:red">@error</p> }
                <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                    <input class="input" @bind-value="loginModel.Username" placeholder="Username" />
                    <input class="input" type="password" @bind-value="loginModel.Password" placeholder="Password" />
                    <button class="btn" type="submit">Login</button>
                </EditForm>
            </div>
        }
      </NotAuthorized>
    </AuthorizeView>
</div>

@code {
  private bool _initialized;
  private bool showLoginForm = false;
  private LoginModel loginModel = new();
  private string? error;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && !_initialized)
    {
      _initialized = true;
      try
      {
        await Points.InitializeAsync();
        await Points.InitializeJavaScriptAsync();
      }
      catch (Exception ex)
      {
        Console.WriteLine($"Home page initialization failed: {ex.Message}");
      }
      StateHasChanged();
    }
  }

  private void ShowLogin()
  {
      showLoginForm = true;
  }

  private async Task HandleLogin()
  {
      var user = Auth.Authenticate(loginModel.Username, loginModel.Password);
      if (user == null)
      {
          error = "Invalid username or password.";
      }
      else
      {
          await AuthStateProvider.MarkUserAsAuthenticated(user);
          Flow.Set(PhilanthroPoints.Services.FlowStep.Demographics);
          Nav.NavigateTo("/demographics");
      }
  }

    private void DemographicsClick(){ Flow.Set(PhilanthroPoints.Services.FlowStep.Demographics); Nav.NavigateTo("/demographics"); }
    private void CardsClick(){ Flow.Set(PhilanthroPoints.Services.FlowStep.Cards); Nav.NavigateTo("/cards"); }
    private void TreatsClick(){ Flow.Set(PhilanthroPoints.Services.FlowStep.Treats); Nav.NavigateTo("/treats"); }
    private void BooksClick(){ Flow.Set(PhilanthroPoints.Services.FlowStep.Books); Nav.NavigateTo("/parent/books"); }
    private void GiftsClick(){ Flow.Set(PhilanthroPoints.Services.FlowStep.Gifts); Nav.NavigateTo("/gifts"); }
    private void CartClick(){ Flow.Set(PhilanthroPoints.Services.FlowStep.Cart); Nav.NavigateTo("/parent/cart"); }
    private void AdminClick() => Nav.NavigateTo("/admin");

  class LoginModel { public string Username { get; set; } = ""; public string Password { get; set; } = ""; }
}

<style>
.birthday-home {
  text-align: center;
  padding: 2rem 1rem;
  max-width: 1200px;
  margin: 0 auto;
}

.welcome-header {
  background: linear-gradient(135deg, #249EA0 0%, #FAAB36 100%);
  color: white;
  padding: 3rem 2rem;
  border-radius: 30px;
  margin-bottom: 2rem;
  box-shadow: 0 12px 32px rgba(36, 158, 160, 0.3);
  animation: fadeInDown 0.8s ease-out;
}

.welcome-header h1 {
  font-size: 2.8rem;
  margin-bottom: 1rem;
  -webkit-text-fill-color: white;
  text-shadow: 2px 2px 8px rgba(0,0,0,0.2);
  font-family: 'Quicksand', sans-serif;
}

.tagline {
  font-size: 1.3rem;
  opacity: 0.95;
  font-weight: 500;
  font-family: 'Nunito', sans-serif;
}

@@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-description {
  color: #666;
  font-size: 0.9rem;
  margin: 0.5rem 0 1rem 0;
  line-height: 1.4;
}

.birthday-home .card {
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.birthday-home .card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 
    0 20px 40px rgba(36, 158, 160, 0.3),
    0 0 0 1px rgba(36, 158, 160, 0.1);
}

.birthday-home .card:hover .category-icon {
  transform: scale(1.1) rotate(5deg);
}

@@media (max-width: 768px) {
  .welcome-header h1 {
    font-size: 2rem;
  }
  
  .tagline {
    font-size: 1.1rem;
  }
  
  .welcome-header {
    padding: 2rem 1rem;
  }
  
  .category-icon {
    font-size: 2.5rem;
  }
  
  .floating-decoration {
    font-size: 1.5rem;
  }
}

.btn-secondary {
  background: #6b7280 !important;
  color: white;
}

.btn-secondary:hover {
  background: #4b5563 !important;
  transform: translateY(-2px);
}
</style>
