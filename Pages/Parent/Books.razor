
@page "/parent/books"
@inject PhilanthroPoints.Services.CatalogService Catalog
@inject PhilanthroPoints.Services.PointsState Points
@inject PhilanthroPoints.Services.CartState Cart
@inject PhilanthroPoints.Services.FlowState Flow
@inject NavigationManager Nav
@using PhilanthroPoints.Components
@implements IDisposable

<div class="page-header">
  <div><h1>📚</h1></div>
  <h1>Books</h1>
  <p>Educational and entertaining books for young readers</p>
</div>

@if (items is null) { <p>Loading...</p> }
else
{
  <div class="grid">
    @foreach (var i in items)
    {
      <div class="card product-card">
        <div class="product-icon"><img src="@i.ImageUrl" height="150"/></div>
        <h3>@i.Name</h3>
        <p class="product-description">@i.Description</p>
        <div class="product-meta">
          <div class="badges">
            <span class="badge cost-badge">💰 @i.Cost points</span> 
            <span class="badge stock-badge">📦 @i.Stock left</span>
          </div>
        </div>
        <button class="btn @(CanBuy(i) ? "" : "disabled")" disabled="@(!CanBuy(i))" @onclick="(()=>Buy(i))">
          @if (CanBuy(i)) { <span>🛒 Add to Cart</span> } else { <span>❌ Cannot Buy</span> }
        </button>
      </div>
    }
  </div>
  <div style="margin-top:1rem">
    <button class="btn" @onclick="Continue" disabled="@(!HasBookInCart())"><span>Proceed to Cards</span></button>
    @if (!HasBookInCart() && hasAttemptedContinue) 
    {
      <p class="card error">Please select at least one book before proceeding.</p>
    }
  </div>
}

@code {
  private List<Item>? items;
  private bool hasAttemptedContinue = false;
  private bool _jsInitialized = false;
  
  protected override async Task OnInitializedAsync() 
  { 
    await Points.InitializeAsync(); 
    items = await Catalog.ByCategoryAsync("Books"); 
    Flow.Set(PhilanthroPoints.Services.FlowStep.Books);
    Cart.OnCartChanged += StateHasChanged;
  }
  
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && !_jsInitialized)
    {
      _jsInitialized = true;
      await Points.InitializeJavaScriptAsync();
      StateHasChanged();
    }
  }
  
  private bool HasBookInCart()
  {
    return Cart.Items.Any(item => item.Category?.Name == "Books");
  }
  
  bool CanBuy(Item i) => Points.Points >= i.Cost && i.Stock > 0;
  async Task Buy(Item i)
  {
    if (await Points.SpendAsync(i.Cost))
    {
      var success = await Cart.AddAsync(i);
      if (!success)
      {
        // Refund points if cart add failed
        await Points.AddAsync(i.Cost);
      }
      StateHasChanged();
    }
  }

  void Continue() 
  {
    hasAttemptedContinue = true;
    if (HasBookInCart())
    {
      Nav.NavigateTo("/parent/cards");
    }
    StateHasChanged();
  }
  
  public void Dispose()
  {
    Cart.OnCartChanged -= StateHasChanged;
  }
}

<style>

h1 {
  font-family: Gotham;
}

h3, span {
  font-family: LilitaOne;
}

.page-header {
  animation: pageEnter 0.8s ease-out;
}

.product-card {
  animation: pageEnter 0.6s ease-out;
  animation-fill-mode: both;
  position: relative;
  overflow: hidden;
}

.product-card:nth-child(1) { animation-delay: 0.1s; }
.product-card:nth-child(2) { animation-delay: 0.2s; }
.product-card:nth-child(3) { animation-delay: 0.3s; }
.product-card:nth-child(4) { animation-delay: 0.4s; }
.product-card:nth-child(5) { animation-delay: 0.5s; }
.product-card:nth-child(6) { animation-delay: 0.6s; }

.product-icon {
  font-size: 2.5rem;
  text-align: center;
  margin-bottom: 1rem;
  animation: bounce 2s ease-in-out infinite;
}

.product-card:hover .product-icon {
  animation: bounce 0.6s ease-in-out;
}

.product-description {
  color: #666;
  font-size: 0.9rem;
  margin-bottom: 1rem;
  font-style: italic;
}

.product-meta {
  margin: 1rem 0;
}

.badges {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.cost-badge {
  background: linear-gradient(135deg, #FAAB36, #F78104);
}

.stock-badge {
  background: linear-gradient(135deg, #249EA0, #008083);
}

.btn.disabled {
  background: #ccc;
  cursor: not-allowed;
  transform: none !important;
}

.btn.disabled:hover {
  box-shadow: none;
  transform: none !important;
}

@@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}
</style>
