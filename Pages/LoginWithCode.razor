@page "/login-with-code"
@inject NavigationManager Nav
@inject PhilanthroPoints.Services.CustomAuthStateProvider AuthStateProvider

<h2 style="text-align:center; color:#2CA6A4; font-size:2.5rem; margin-bottom:2rem;">Guest Login</h2>
<div class="login-card" style="background:#B3E0EA; border-radius:16px; max-width:600px; margin:2rem auto; padding:2.5rem; box-shadow:0 2px 16px rgba(44,166,164,0.08);">
  <label for="agencySelect" style="font-size:1.2rem; font-weight:500; color:#2CA6A4; margin-bottom:0.5rem;">Agency *</label>
  <select id="agencySelect" class="input" @bind="selectedAgency" style="width:100%; padding:1rem; font-size:1.1rem; border-radius:8px; border:1px solid #2CA6A4; margin-bottom:1.5rem;">
    <option value="">Select an Agency</option>
    <option>Big Brothers Big Sisters</option>
    <option>Children's Center for Visually Impaired</option>
    <option>Cornerstones of Care</option>
    <option>Demonstration</option>
    <option>HALO</option>
    <option>Hillcrest Transitional Housing</option>
    <option>i.c.stars</option>
    <option>Jackson County Courts</option>
    <option>KC Cares</option>
    <option>KC Heroes</option>
    <option>Metro Lutheran Ministries</option>
    <option>PACES</option>
    <option>Rose Brooks</option>
    <option>Turner Parents as Teachers</option>
  </select>
  <div style="display:flex; gap:1rem; margin-bottom:1.5rem;">
    <div>
      <label style="font-size:1.1rem; color:#2CA6A4;">Month</label><br />
      <input type="text" maxlength="2" placeholder="MM" @bind="birthdayMonth" style="width:40px; margin-right:8px;" />
    </div>
    <div>
      <label style="font-size:1.1rem; color:#2CA6A4;">Day</label><br />
      <input type="text" maxlength="2" placeholder="DD" @bind="birthdayDay" style="width:40px;" />
    </div>
    <div>
      <label style="font-size:1.1rem; color:#2CA6A4;">Age</label><br />
      <input type="text" maxlength="2" placeholder="Age" @bind="childage" style="width:40px;" />
    </div>
    <div>
      <label style="font-size:1.1rem; color:#2CA6A4;">App #</label><br />
      <input type="text" maxlength="2" placeholder="01" @bind="applicationNumber" style="width:40px;" />
    </div>
  </div>
  <div style="margin-bottom:1.5rem; text-align:center;">
    <label style="font-size:1.1rem; color:#2CA6A4;">Code Preview:</label><br />
    <span style="font-size:1.3rem; background:#e6f6f9; padding:0.5rem 1.2rem; border-radius:8px; border:1px solid #B3E0EA; display:inline-block; margin-top:0.5rem;">
      @CodePreview
    </span>
  </div>
  <button class="btn" @onclick="PerformLoginWithCode" style="width:60%; margin:0 auto; display:block; padding:1rem 0; font-size:1.3rem; font-weight:500; color:#fff; background:linear-gradient(90deg,#2CA6A4 0%,#F6C343 100%); border:none; border-radius:24px; box-shadow:0 2px 8px rgba(44,166,164,0.12);">Login as Guest</button>
  @if (!string.IsNullOrEmpty(loginStatus))
  {
    <div class="login-status" style="margin-top:2rem; color:@(loginStatus.StartsWith("✅") ? "#2CA6A4" : "#F6C343"); font-weight:bold; text-align:center; font-size:1.2rem;">@loginStatus</div>
  }
</div>

@code {
  private string selectedAgency = string.Empty;
  private string birthdayMonth = string.Empty;
  private string birthdayDay = string.Empty;
  private string childage = string.Empty;
  private string applicationNumber = string.Empty;
  private string loginStatus = string.Empty;
  private string CodePreview => selectedAgency.Length >= 3
    ? selectedAgency.ToUpper().Substring(0, 3)
      + (birthdayMonth.Length >= 2 ? birthdayMonth.Substring(0, 2) : birthdayMonth.PadLeft(2, '0'))
      + (birthdayDay.Length >= 2 ? birthdayDay.Substring(0, 2) : birthdayDay.PadLeft(2, '0'))
      + (childage.Length >= 2 ? childage.Substring(0, 2) : childage.PadLeft(2, '0'))
      + (applicationNumber.Length >= 2 ? applicationNumber.Substring(0, 2) : applicationNumber.PadLeft(2, '0'))
    : "";

  private async Task PerformLoginWithCode()
  {
    if (string.IsNullOrWhiteSpace(selectedAgency) || selectedAgency.Length < 3 || string.IsNullOrWhiteSpace(birthdayMonth) || string.IsNullOrWhiteSpace(birthdayDay) || string.IsNullOrWhiteSpace(childage) || string.IsNullOrWhiteSpace(applicationNumber))
    {
      loginStatus = "\u274c Please enter valid agency (3 letters), month, day, age, and application number. Code must be 3 letters and 8 digits.";
      StateHasChanged();
      return;
    }
    var code = selectedAgency.ToUpper().Substring(0, 3)
      + (birthdayMonth.Length >= 2 ? birthdayMonth.Substring(0, 2) : birthdayMonth.PadLeft(2, '0'))
      + (birthdayDay.Length >= 2 ? birthdayDay.Substring(0, 2) : birthdayDay.PadLeft(2, '0'))
      + (childage.Length >= 2 ? childage.Substring(0, 2) : childage.PadLeft(2, '0'))
      + (applicationNumber.Length >= 2 ? applicationNumber.Substring(0, 2) : applicationNumber.PadLeft(2, '0'));
    {
      var guest = new PhilanthroPoints.Models.Member {
        Username = code,
        FirstName = "Guest",
        LastName = "",
        Email = "guest@philanthropoints.local"
      };
      await AuthStateProvider.MarkUserAsAuthenticated(guest);
      loginStatus = "\u2705 Login successful! You are now logged in as a guest.";
      StateHasChanged();
      Nav.NavigateTo("/demographics");
    }
  }
}

<style>
  .login-card { max-width: 400px; margin: 2rem auto; padding: 2rem; background: #fff; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); }
  .login-card label { display: block; margin-bottom: 0.5rem; font-size: 1.2rem; font-weight: 500; }
  .login-card select.input { width: 100%; padding: 0.75rem; font-size: 1.1rem; border-radius: 4px; border: 1px solid #222; margin-bottom: 1rem; }
  .login-card input.input { width: 100%; padding: 0.75rem; font-size: 1.1rem; border-radius: 4px; border: 1px solid #222; }
</style>
