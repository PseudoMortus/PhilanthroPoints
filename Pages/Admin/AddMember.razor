@page "/admin/add-member"
@using PhilanthroPoints.Models
@inject PhilanthroPoints.Services.PointsService PointsSvc
@inject NavigationManager Navigation

<h2>Add New Member</h2>

@if (!string.IsNullOrEmpty(status))
{
    <div class="alert">@status</div>
}

<EditForm Model="newMember" OnValidSubmit="CreateMember">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-grid">
        <div class="form-field">
            <label>Username *</label>
            <InputText @bind-Value="newMember.Username" class="input" />
            <ValidationMessage For="@(() => newMember.Username)" />
        </div>
        <div class="form-field">
            <label>Email *</label>
            <InputText @bind-Value="newMember.Email" class="input" />
            <ValidationMessage For="@(() => newMember.Email)" />
        </div>
        <div class="form-field">
            <label>Password *</label>
            <InputText @bind-Value="tempMemberPassword" type="password" class="input" />
        </div>
        <div class="form-field">
            <label>First Name *</label>
            <InputText @bind-Value="newMember.FirstName" class="input" />
            <ValidationMessage For="@(() => newMember.FirstName)" />
        </div>
        <div class="form-field">
            <label>Last Name *</label>
            <InputText @bind-Value="newMember.LastName" class="input" />
            <ValidationMessage For="@(() => newMember.LastName)" />
        </div>
        <div class="form-field">
            <label>Initial Points</label>
            <InputNumber @bind-Value="newMember.Points" class="input" min="0" />
            <ValidationMessage For="@(() => newMember.Points)" />
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-success" disabled="@isCreatingMember">
            @if (isCreatingMember)
            {
                <span>⏳ Creating...</span>
            }
            else
            {
                <span>✅ Create Member</span>
            }
        </button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">❌ Cancel</button>
    </div>
</EditForm>

@code {
    private Member newMember = new();
    private string tempMemberPassword = string.Empty;
    private bool isCreatingMember = false;
    private string? status;

    private async Task CreateMember()
    {
        isCreatingMember = true;
        status = null;
        try
        {
            if (string.IsNullOrWhiteSpace(tempMemberPassword))
            {
                status = "Password is required.";
                isCreatingMember = false;
                return;
            }
            newMember.PasswordHash = PhilanthroPoints.Services.PasswordHasher.Hash(tempMemberPassword);
            var result = await PointsSvc.AddMemberAsync(newMember);
            if (result)
            {
                status = $"Member '{newMember.Username}' created successfully!";
                Navigation.NavigateTo("/admin/inventory?tab=members", true);
            }
            else
            {
                status = "Failed to create member. Username or email may already exist.";
            }
        }
        catch (Exception ex)
        {
            status = $"Error: {ex.Message}";
        }
        isCreatingMember = false;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/inventory?tab=members");
    }
}
