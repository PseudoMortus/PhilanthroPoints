      <div style="margin-bottom:1.2rem;">
        <label for="agencySelect" style="font-size:1.2rem; font-weight:500; color:#178a7c; margin-bottom:0.5rem;">Agency *</label>
        <select id="agencySelect" class="input" @bind="agencyAbbrev" style="width:100%; padding:1rem; font-size:1.1rem; border-radius:8px; border:1px solid #222; margin-bottom:1rem;">
          <option value="">Select an Agency</option>
          <option>Big Brothers Big Sisters</option>
          <option>Children's Center for Visually Impaired</option>
          <option>Cornerstones of Care</option>
          <option>Demonstration</option>
          <option>HALO</option>
          <option>Hillcrest Transitional Housing</option>
          <option>i.c.stars</option>
          <option>Jackson County Courts</option>
          <option>KC Cares</option>
          <option>KC Heroes</option>
          <option>Metro Lutheran Ministries</option>
          <option>PACES</option>
          <option>Rose Brooks</option>
          <option>Turner Parents as Teachers</option>
        </select>
      </div>
      <div style="margin-bottom:1.2rem; display:flex; align-items:center; gap:1.2rem;">
        <div>
          <label style="font-size:1.1rem; color:#178a7c;">Child's Birthday</label><br />
          <input type="text" maxlength="2" placeholder="MM" @bind="birthdayMonth" style="width:40px; margin-right:8px;" /> /
          <input type="text" maxlength="2" placeholder="DD" @bind="birthdayDay" style="width:40px;" />
        </div>
        <div>
          <label style="font-size:1.1rem; color:#178a7c;">Age</label><br />
          <input type="text" maxlength="2" placeholder="Age" @bind="childage" style="width:40px;" />
        </div>
      </div>
      <div style="margin-bottom:1.2rem;">
        <label style="font-size:1.1rem; color:#178a7c;">Application Number</label>
        <input type="text" maxlength="2" placeholder="01" @bind="applicationNumber" style="width:40px; margin-left:8px;" />
      </div>
      <div style="display:flex; gap:1.5rem; justify-content:center; margin-top:2rem;">
        <button class="btn" style="background:#2ecc40; color:#fff; font-size:1.2rem; padding:0.8rem 2.2rem; border-radius:16px; box-shadow:0 2px 8px rgba(44,166,164,0.12);" @onclick="GenerateFamilyLoginCode">Generate</button>
        <button class="btn" style="background:#6c757d; color:#fff; font-size:1.2rem; padding:0.8rem 2.2rem; border-radius:16px; box-shadow:0 2px 8px rgba(44,166,164,0.12);" @onclick="HideCodePopup">Cancel</button>
      </div>
      @if (!string.IsNullOrEmpty(generatedFamilyCode))
      {
        <div style="margin-top:1.5rem; color:#178a7c; font-weight:bold; text-align:center; font-size:1.2rem;">Generated Code: @generatedFamilyCode</div>
      }
    </div>
  }
  @if (IsSuperAdmin && TempFamilyCodes.Any())
  {
    <div class="table-container" style="margin-top:2rem;">
      <h4>Generated Family Login Codes</h4>
      <table class="inv">
        <thead>
          <tr>
            <th>Family Login Code</th>
            <th>Agency</th>
            <th>Application Number</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var info in TempFamilyCodes)
          {
            <tr>
              <td>@info.Code</td>
              <td>@info.Agency</td>
              <td>@info.ApplicationNumber</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
}

@if (activeTab == "monitor")
{
<div class="card">
  <h3>📊 Cart & Stock Monitor</h3>
  <div class="monitor-grid">
    <div class="monitor-card">
      <h4>⚠️ Low Stock Alert (=5 items)</h4>
      @if (lowStockItems?.Any() == true)
      {
        <div class="alert-list">
          @foreach (var item in lowStockItems)
          {
            <div class="alert-item low-stock">
              <span class="item-name">@item.Name (@item.Category?.Name)</span>
              <span class="stock-count">@item.Stock left</span>
            </div>
          }
        </div>
      }
      else
      {
        <p class="no-alerts">? All items have sufficient stock!</p>
      }
    </div>
    
    <div class="monitor-card">
      <h4>? Out of Stock</h4>
      @if (outOfStockItems?.Any() == true)
      {
        <div class="alert-list">
          @foreach (var item in outOfStockItems)
          {
            <div class="alert-item out-of-stock">
              <span class="item-name">@item.Name (@item.Category?.Name)</span>
              <span class="stock-count">SOLD OUT</span>
            </div>
          }
        </div>
      }
      else
      {
        <p class="no-alerts">? No items out of stock!</p>
      }
    </div>
    
    <div class="monitor-card">
      <h4>📊 Stock Summary by Category</h4>
      @if (stockSummary?.Any() == true)
      {
        <div class="summary-list">
          @foreach (var category in stockSummary)
          {
            <div class="summary-item">
              <span class="category-name">@category.Key</span>
              <span class="total-stock">@category.Value items</span>
            </div>
          }
        </div>
      }
      else
      {
        <p class="no-alerts">Loading summary...</p>
      }
    </div>
  </div>
  
  <div class="monitor-actions">
    <button class="btn btn-primary" @onclick="RefreshMonitorData">🔄 Refresh Monitor</button>
    <span class="last-updated">Last updated: @lastMonitorUpdate.ToString("HH:mm:ss")</span>
  </div>
</div>
}

@if (activeTab == "users")
{
<div class="card">
  <h3>👤 Manage Users</h3>
  <div class="toolbar">
    <button class="btn btn-primary" @onclick="ShowAddUserForm">👥 Add New User</button>
    <button class="btn btn-refresh" @onclick="RefreshUsersData">🔄 Refresh Users</button>
  </div>

  @if (showAddUserForm)
  {
    <div class="add-form">
      <h4>Add New User</h4>
      <EditForm Model="newUser" OnValidSubmit="CreateUser">
        <div class="form-grid">
          <div class="form-field">
            <label>Username *</label>
            <InputText @bind-Value="newUser.Username" class="input" />
          </div>
          <div class="form-field">
            <label>Email *</label>
            <InputText @bind-Value="newUser.Email" class="input" />
          </div>
          <div class="form-field">
            <label>First Name *</label>
            <InputText @bind-Value="newUser.FirstName" class="input" />
          </div>
          <div class="form-field">
            <label>Last Name *</label>
            <InputText @bind-Value="newUser.LastName" class="input" />
          </div>
          <div class="form-field">
            <label>Phone</label>
            <InputText @bind-Value="newUser.PhoneNumber" class="input" />
          </div>
          <div class="form-field">
            <label>Date of Birth</label>
            <InputDate @bind-Value="newUser.DateOfBirth" class="input" />
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-success">✅ Create User</button>
          <button type="button" class="btn btn-secondary" @onclick="CancelAddUser">❌ Cancel</button>
        </div>
      </EditForm>
    </div>
  }

  <div class="table-container">
    <table class="inv">
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Name</th>
          <th>Email</th>
          <th>Created</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var user in users)
        {
          <tr>
            <td class="id">@user.Id</td>
            <td><strong>@user.Username</strong></td>
            <td>@user.FirstName @user.LastName</td>
            <td>@user.Email</td>
            <td>@user.CreatedDate.ToString("MM/dd/yyyy")</td>
            <td>
              @if (user.IsActive)
              {
                <span class="status-badge active">Active</span>
              }
              else
              {
                <span class="status-badge inactive">Inactive</span>
              }
            </td>
            <td>
              <div class="action-btns">
                <button class="btn-sm btn-edit" @onclick="() => StartEditUser(user)">✏️</button>
                <button class="btn-sm btn-remove" @onclick="() => DeleteUser(user.Id)">🗑️</button>
                <button class="btn-sm btn-add" @onclick="() => AddPointsToUser(user.Id, 100)">➕</button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

