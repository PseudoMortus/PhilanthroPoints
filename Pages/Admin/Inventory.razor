      {
        adminToUpdate.Username = editAdmin.Username;
        adminToUpdate.FirstName = editAdmin.FirstName;
        adminToUpdate.LastName = editAdmin.LastName;
        adminToUpdate.Email = editAdmin.Email;
        adminToUpdate.Role = editAdmin.Role;
        adminToUpdate.Department = editAdmin.Department;
