@code {
  // Member editing logic for inline editing in Members table
  private int editingMemberId = 0;
  private int editMemberPoints = 0;

  void StartEditMember(Member m)
  {
    editingMemberId = m.Id;
    editMemberPoints = m.Points;
  }

  void CancelEditMember()
  {
    editingMemberId = 0;
    editMemberPoints = 0;
  }

  void SaveMemberPoints(int memberId)
  {
    var member = members.FirstOrDefault(x => x.Id == memberId);
    if (member != null)
    {
      var diff = editMemberPoints - member.Points;
      if (diff > 0)
      {
        PointsSvc.AddPoints(memberId, diff);
      }
      else if (diff < 0)
      {
        PointsSvc.RemovePoints(memberId, -diff);
      }
      members = PointsSvc.GetAllMembers();
      status = $"✅ Points updated for {member.Username}.";
    }
    editingMemberId = 0;
    editMemberPoints = 0;
    StateHasChanged();
  }

    async Task RemoveMember(int memberId)
    {
      var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to remove this member? This cannot be undone.");
      if (!confirmed) return;
      var result = PointsSvc.RemoveMember(memberId);
      if (result)
      {
        status = "✅ Member removed successfully.";
        members = PointsSvc.GetAllMembers();
        StateHasChanged();
      }
      else
      {
        status = "❌ Failed to remove member.";
      }
    }
  private string activeTab = null;
  private List<Item> items = new();
  private List<Item> filtered = new();
  private List<Category> categories = new();
  private List<Member> members = new();
  private List<User> users = new();
  private List<AdminUser> adminUsers = new();
  private List<Family> families = new();
  private Dictionary<int, int> pointsInputs = new();
  private string? search;
  private string? categoryFilter;
  private string? status;
  private bool showAddForm = false;
  private bool showAddUserForm = false;
  private bool showAddAdminForm = false;
  private bool isSubmitting = false;
  private bool isRefreshing = false;
  
  // Monitor variables
  private List<Item>? lowStockItems = new();
  private List<Item>? outOfStockItems = new();
  private Dictionary<string, int>? stockSummary = new();
  private DateTime lastMonitorUpdate = DateTime.Now;
  
  // User management
  private User newUser = new();
  private AdminUser newAdmin = new();
  private string tempPassword = "";
  
  // Family management
  private Family? selectedFamily = null;
  private int editingFamilyId = 0;
  private Family editFamily = new();
  private Family originalFamily = new();
  
  // Admin user editing
  private int editingAdminId = 0;
  private AdminUser editAdmin = new();
  private AdminUser originalAdmin = new();
  
  // User editing
  private int editingUserId = 0;
  private User editUser = new();
  private User originalUser = new();
  
  private int editingItemId = 0;
  private Item editItem = new();
  private Item originalItem = new(); // For undo functionality
  private Item newItem = new();


  async Task RefreshData()
  {
    categories = await Catalog.CategoriesAsync();
    items = await Catalog.AllAsync();
    members = PointsSvc.GetAllMembers();
    users = await UserSvc.GetAllUsersAsync();
    adminUsers = await AdminSvc.GetAllAdminUsersAsync();
    
    // Load families from database
    families = DbContext.Families.ToList();
    
    // Initialize points inputs
    foreach (var m in members)
    {
      pointsInputs[m.Id] = 10;
    }
    await ApplyFilters();
    StateHasChanged();
  }
  
  async Task ForceRefresh()
  {
    isRefreshing = true;
    status = "🔄 Refreshing data from database...";
    StateHasChanged();
    
    try
    {
      // Cancel any ongoing edits first
      editingItemId = 0;
      editItem = new();
      originalItem = new();
      showAddForm = false;
      
      // Clear current data
      items.Clear();
      categories.Clear();
      members.Clear();
      filtered.Clear();
      
      // Force UI update to show cleared state
      StateHasChanged();
      
      // Small delay to show the clearing
      await Task.Delay(100);
      
      // Refresh from database
      categories = await Catalog.CategoriesAsync();
      items = await Catalog.AllAsync();
      members = PointsSvc.GetAllMembers();
      
      // Reinitialize points inputs
      pointsInputs.Clear();
      foreach (var m in members)
      {
        pointsInputs[m.Id] = 10;
      }
      
      // Apply current filters
      await ApplyFilters();
      
      status = "? Data refreshed successfully!";
      
      // Clear status after a delay
      await Task.Delay(2000);
      if (status?.Contains("refreshed successfully") == true)
      {
        status = null;
      }
    }
    catch (Exception ex)
    {
      status = $"? Error refreshing data: {ex.Message}";
      Console.WriteLine($"ForceRefresh Error: {ex}");
    }
    finally
    {
      isRefreshing = false;
      StateHasChanged();
    }
  }

  void SetTab(string tab)
  {
    activeTab = tab;
    status = null;
    showAddForm = false; // Hide form when switching tabs
    editingItemId = 0;   // Cancel any ongoing edits
    
    // Set category filter based on tab
    if (tab == "gifts") categoryFilter = "Gifts";
    else if (tab == "treats") categoryFilter = "Treats";
    else if (tab == "cards") categoryFilter = "Cards";
    else if (tab == "inventory") categoryFilter = "";
    
    if (tab == "monitor")
    {
      _ = RefreshMonitorData(); // Fire and forget
    }
    
    _ = ApplyFilters();
  }

  async Task ApplyFilters()
  {
    if (activeTab == "inventory" || activeTab == "gifts" || activeTab == "treats" || activeTab == "cards")
    {
      filtered = await Catalog.SearchItemsAsync(search ?? "", 
        activeTab == "inventory" ? categoryFilter : activeTab.Substring(0, 1).ToUpper() + activeTab.Substring(1));
    }
  }

  async Task OnSearchChanged(ChangeEventArgs e)
  {
    search = e.Value?.ToString();
    await ApplyFilters();
  }

  async Task OnCategoryChanged(ChangeEventArgs e)
  {
    categoryFilter = e.Value?.ToString();
    await ApplyFilters();
  }

  void ClearFilters()
  {
    search = "";
    categoryFilter = "";
    _ = ApplyFilters();
  }

  void ShowAddItemForm(string? categoryName = null)
  {
    showAddForm = true;
    newItem = new Item();
    
    // Auto-set category if specified
    if (!string.IsNullOrEmpty(categoryName))
    {
      var category = categories.FirstOrDefault(c => c.Name == categoryName);
      if (category != null)
      {
        newItem.CategoryId = category.Id;
      }
    }
    
    status = null;
  }

  void CancelAddItem()
  {
    showAddForm = false;
    newItem = new();
  }

  async Task SubmitNewItem()
  {
    if (newItem.CategoryId <= 0)
    {
      status = "? Please select a category.";
      return;
    }

    isSubmitting = true;
    var success = await Catalog.AddItemAsync(newItem);
    isSubmitting = false;

    if (success)
    {
      status = $"? Item '{newItem.Name}' added successfully!";
      showAddForm = false;
      newItem = new();
      await RefreshData();
    }
    else
    {
      status = "? Failed to add item. Please try again.";
    }
  }

  void StartEdit(Item item)
  {
    editingItemId = item.Id;
    // Store original item for undo functionality
    originalItem = new Item
    {
      Id = item.Id,
      Name = item.Name,
      Description = item.Description,
      ImageUrl = item.ImageUrl,
      Cost = item.Cost,
      Stock = item.Stock,
      CategoryId = item.CategoryId
    };
    // Create editable copy
    editItem = new Item
    {
      Id = item.Id,
      Name = item.Name,
      Description = item.Description,
      ImageUrl = item.ImageUrl,
      Cost = item.Cost,
      Stock = item.Stock,
      CategoryId = item.CategoryId
    };
  }

  async Task SaveEdit()
  {
    try
    {
      Console.WriteLine("SaveEdit called");
      
      // Validate input
      if (string.IsNullOrWhiteSpace(editItem.Name))
      {
        status = "? Item name is required.";
        StateHasChanged();
        return;
      }
      
      if (editItem.Cost <= 0)
      {
        status = "? Item cost must be greater than 0.";
        StateHasChanged();
        return;
      }
      
      if (editItem.Stock < 0)
      {
        status = "? Stock cannot be negative.";
        StateHasChanged();
        return;
      }

      // Show saving status
      status = "💾 Saving changes...";
      StateHasChanged();
      
      Console.WriteLine($"Updating item: {editItem.Name}, Cost: {editItem.Cost}, Stock: {editItem.Stock}");
      
      // Perform the update
      var success = await Catalog.UpdateItemAsync(editItem);
      
      Console.WriteLine($"Update result: {success}");
      
      if (success)
      {
        status = $"? Item '{editItem.Name}' updated successfully!";
        
        // Exit edit mode
        editingItemId = 0;
        originalItem = new();
        
        // Refresh the data to show changes
        await RefreshData();
        
        Console.WriteLine("Save completed successfully");
      }
      else
      {
        status = "? Failed to update item. Please check your input and try again.";
      }
      
      StateHasChanged();
    }
    catch (Exception ex)
    {
      status = $"? Error updating item: {ex.Message}";
      Console.WriteLine($"SaveEdit Error: {ex}");
      StateHasChanged();
    }
  }

  void UndoEdit()
  {
    Console.WriteLine("UndoEdit called");
    
    // Restore original values
    editItem.Name = originalItem.Name;
    editItem.Description = originalItem.Description;
    editItem.ImageUrl = originalItem.ImageUrl;
    editItem.Cost = originalItem.Cost;
    editItem.Stock = originalItem.Stock;
    editItem.CategoryId = originalItem.CategoryId;
    
    status = "? Changes undone - original values restored.";
    StateHasChanged();
    
    Console.WriteLine("Undo completed");
  }
  
  void CancelEdit()
  {
    Console.WriteLine("CancelEdit called");
    
    editingItemId = 0;
    editItem = new();
    originalItem = new();
    status = "? Edit cancelled.";
    StateHasChanged();
    
    Console.WriteLine("Cancel completed");
  }

  async Task DeleteItem(int id)
  {
    var item = items.FirstOrDefault(i => i.Id == id);
    if (item == null) return;

    // Simple confirmation
    var success = await Catalog.DeleteItemAsync(id);
    if (success)
    {
      status = $"? Item '{item.Name}' deleted successfully!";
      await RefreshData();
    }
    else
    {
      status = "? Failed to delete item.";
    }
  }

  void AddPointsToMember(int memberId)
  {
    var amount = pointsInputs.GetValueOrDefault(memberId, 0);
    if (amount <= 0)
    {
      status = "⚠️ Please enter a positive amount.";
      return;
    }
    
    if (PointsSvc.AddPoints(memberId, amount))
    {
      members = PointsSvc.GetAllMembers();
      status = $"? Added {amount} points.";
    }
    else
    {
      status = "? Failed to add points.";
    }
  }

  void RemovePointsFromMember(int memberId)
  {
    var amount = pointsInputs.GetValueOrDefault(memberId, 0);
    if (amount <= 0)
    {
      status = "⚠️ Please enter a positive amount.";
      return;
    }
    
    if (PointsSvc.RemovePoints(memberId, amount))
    {
      members = PointsSvc.GetAllMembers();
      status = $"? Removed {amount} points.";
    }
    else
    {
      status = "? Failed to remove points.";
    }
  }

  async Task RefreshMonitorData()
  {
    try
    {
      status = "🔄 Refreshing monitor data...";
      StateHasChanged();
      
      lowStockItems = await Monitor.GetLowStockItemsAsync(5);
      outOfStockItems = await Monitor.GetOutOfStockItemsAsync();
      stockSummary = await Monitor.GetStockSummaryAsync();
      lastMonitorUpdate = DateTime.Now;
      
      status = "? Monitor data refreshed successfully!";
      StateHasChanged();
    }
    catch (Exception ex)
    {
      status = $"? Error refreshing monitor: {ex.Message}";
      StateHasChanged();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await RefreshMonitorData();
    }
  }

  // User Management Methods
  async Task RefreshUsersData()
  {
    users = await UserSvc.GetAllUsersAsync();
    StateHasChanged();
  }

  async Task RefreshAdminData()
  {
    adminUsers = await AdminSvc.GetAllAdminUsersAsync();
    StateHasChanged();
  }

  void ShowAddUserForm()
  {
    newUser = new User { DateOfBirth = DateTime.Now.AddYears(-25) };
    showAddUserForm = true;
  }

  void ShowAddAdminForm()
  {
    newAdmin = new AdminUser();
    tempPassword = "";
    showAddAdminForm = true;
  }

  void CancelAddUser()
  {
    showAddUserForm = false;
    newUser = new();
  }

  void CancelAddAdmin()
  {
    showAddAdminForm = false;
    newAdmin = new();
    tempPassword = "";
  }

  async Task CreateUser()
  {
    try
    {
      var success = await UserSvc.CreateUserAsync(newUser);
      if (success)
      {
        status = $"? User '{newUser.Username}' created successfully!";
        showAddUserForm = false;
        newUser = new();
        await RefreshUsersData();
      }
      else
      {
        status = "? Failed to create user. Username or email may already exist.";
      }
    }
    catch (Exception ex)
    {
      status = $"? Error creating user: {ex.Message}";
    }
  }

  async Task CreateAdmin()
  {
    try
    {
      if (string.IsNullOrWhiteSpace(tempPassword))
      {
        status = "? Password is required for admin users.";
        return;
      }

      newAdmin.PasswordHash = PhilanthroPoints.Services.PasswordHasher.Hash(tempPassword);
      var success = await AdminSvc.CreateAdminUserAsync(newAdmin);
      
      if (success)
      {
        status = $"? Admin user '{newAdmin.Username}' created successfully!";
        showAddAdminForm = false;
        newAdmin = new();
        tempPassword = "";
        await RefreshAdminData();
      }
      else
      {
        status = "? Failed to create admin user. Username or email may already exist.";
      }
    }
    catch (Exception ex)
    {
      status = $"? Error creating admin: {ex.Message}";
    }
