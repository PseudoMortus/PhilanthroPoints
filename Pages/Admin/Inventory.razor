@code {
  // Family login code generator popup state
  private bool showCodePopup = false;
  private string agencyAbbrev = "";
  private string birthdayMonth = "";
  private string birthdayDay = "";
  private string applicationNumber = "";
  private string childage = "";
  private string generatedFamilyCode = string.Empty;

  // Temporary in-memory list for generated codes with agency and app number
  public class FamilyLoginCodeInfo {
    public string Code { get; set; } = "";
    public string Agency { get; set; } = "";
    public string ApplicationNumber { get; set; } = "";
  }
  public static List<FamilyLoginCodeInfo> TempFamilyCodes { get; set; } = new();

  private void ShowCodePopup() { showCodePopup = true; generatedFamilyCode = string.Empty; }
  private void HideCodePopup() { showCodePopup = false; agencyAbbrev = ""; birthdayMonth = ""; birthdayDay = ""; applicationNumber = ""; generatedFamilyCode = string.Empty; }

  private async Task GenerateFamilyLoginCode()
  {
    // Validate input (applicationNumber will be auto-filled)
    if (string.IsNullOrWhiteSpace(agencyAbbrev) || agencyAbbrev.Length < 3 || string.IsNullOrWhiteSpace(birthdayMonth) || string.IsNullOrWhiteSpace(birthdayDay) || string.IsNullOrWhiteSpace(childage))
    {
      status = "❌ Please enter valid agency (3 letters), month, day, and age. Code must be 3 letters and 8 digits.";
      StateHasChanged();
      return;
    }

    // Get or create AgencyApplicationNumber for this agency/month/year
    var now = DateTime.UtcNow;
    var agencyKey = agencyAbbrev.ToUpper().Substring(0, 3);
    var appNum = await DbContext.AgencyApplicationNumbers.FirstOrDefaultAsync(a => a.AgencyAbbrev == agencyKey && a.Year == now.Year && a.Month == now.Month);
    if (appNum == null)
    {
      appNum = new PhilanthroPoints.Models.AgencyApplicationNumber {

      };
      DbContext.AgencyApplicationNumbers.Add(appNum);
    }
    else
    {
      appNum.LastNumber++;
    }
    await DbContext.SaveChangesAsync();
    applicationNumber = appNum.LastNumber.ToString().PadLeft(2, '0');

    // Format: [ABC][MM][DD][AA][NN] (ABC = first 3 of agency, MM = month, DD = day, AA = age, NN = app number)
    var code = agencyKey
      + birthdayMonth.PadLeft(2, '0').Substring(0, 2)
      + birthdayDay.PadLeft(2, '0').Substring(0, 2)
      + childage.PadLeft(2, '0').Substring(0, 2)
      + applicationNumber;
    generatedFamilyCode = code;
    TempFamilyCodes.Add(new FamilyLoginCodeInfo {
      Code = code,
      Agency = agencyAbbrev,
      ApplicationNumber = applicationNumber
    }); // Save code, agency, and app number temporarily
    status = $"✅ Family login code generated: {generatedFamilyCode}";
    StateHasChanged();
  }

  private string? currentUsername;
  private bool IsSuperAdmin => adminUsers.FirstOrDefault(a => a.Username == currentUsername)?.Role == "Super Admin";

  protected override async Task OnInitializedAsync()
  {
    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    currentUsername = authState.User.Identity?.Name;
    // Call the rest of the original OnInitializedAsync logic
    await RefreshData();
    responses = await Db.FamilySurveyResponses.ToListAsync();
  }
}



@if (activeTab == "inventory")
{
<div class="category-page">
  <div class="card">
    <h2>📦 Inventory</h2>
    <div class="toolbar">
      <input @bind="search" @oninput="OnSearchChanged" placeholder="🔍 Search items..." />
      <select value="@categoryFilter" @onchange="OnCategoryChanged">
        <option value="">All Categories</option>
        @foreach (var c in categories)
        {
          <option value="@c.Name">@c.Name</option>
        }
      </select>
      <button class="btn btn-primary" @onclick='() => ShowAddItemForm("")'>📦 Add Inventory</button>
    </div>
    @if (showAddForm)
    {
      <div class="card add-form">
        <h4>Add New Inventory</h4>
        <EditForm Model="newItem" OnValidSubmit="SubmitNewItem">
          <DataAnnotationsValidator />
          <ValidationSummary />
          <div class="form-grid">
            <div class="form-field">
              <label>Name *</label>
              <InputText @bind-Value="newItem.Name" class="input" />
              <ValidationMessage For="@(() => newItem.Name)" />
            </div>
            <div class="form-field">
              <label>Description</label>
              <InputText @bind-Value="newItem.Description" class="input" />
            </div>
            <div class="form-field">
              <label>Category</label>
              <select @bind="newItem.CategoryId" @bind:event="onchange"  class="input">
                @foreach (var c in categories)
                {
                  <option value="@c.Id" selected="@(editItem.CategoryId == c.Id)">@c.Name</option>
                }
              </select>
            </div>
            <div class="form-field">
              <label>Image URL</label>
              <InputText @bind-Value="newItem.ImageUrl" class="input" />
            </div>
            <div class="form-field">
              <label>Cost *</label>
              <InputNumber @bind-Value="newItem.Cost" class="input" min="0" />
              <ValidationMessage For="@(() => newItem.Cost)" />
            </div>
            <div class="form-field">
              <label>Stock *</label>
              <InputNumber @bind-Value="newItem.Stock" class="input" min="0" />
              <ValidationMessage For="@(() => newItem.Stock)" />
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-success" disabled="@isSubmitting">
              @if (isSubmitting)
              {
                <span>⏳ Adding...</span>
              }
              else
              {
                <span>✅ Add Inventory</span>
              }
            </button>
            <button type="button" class="btn btn-secondary" @onclick="CancelAddItem">❌ Cancel</button>
          </div>
        </EditForm>
      </div>
    }
    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(categoryFilter))
    {
    }
    <div class="table-container">
      <table class="inv">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Image</th>
            <th>Category</th>
            <th>Cost</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (filtered.Any())
          {
            @foreach (var item in filtered)
            {
              <tr class="@(editingItemId == item.Id ? "editing" : "")">
                <td class="id">@item.Id</td>
                @if (editingItemId == item.Id)
                {
                  <td><input @bind="editItem.Name" @bind:event="oninput" class="edit-input" placeholder="Item name..." /></td>
                  <td><textarea @bind="editItem.Description" @bind:event="oninput" class="edit-textarea" rows="2" placeholder="Description..."></textarea></td>
                  <td><input @bind="editItem.ImageUrl" @bind:event="oninput" class="edit-input" placeholder="Image URL..." /></td>
                  <td>
                    <select @bind="editItem.CategoryId" @bind:event="onchange" class="edit-select">
                      @foreach (var c in categories)
                      {
                        <option value="@c.Id" selected="@(editItem.CategoryId == c.Id)">@c.Name</option>
                      }
                    </select>
                  </td>
                  <td><input type="number" @bind="editItem.Cost" @bind:event="oninput" class="edit-input-sm" min="1" step="1" placeholder="Cost" /></td>
                  <td><input type="number" @bind="editItem.Stock" @bind:event="oninput" class="edit-input-sm" min="0" step="1" placeholder="Stock" /></td>
                  <td class="actions">
                    <button type="button" class="btn-sm btn-success" @onclick="SaveEdit" title="Save Changes">✔️ Save</button>
                    <button type="button" class="btn-sm btn-warning" @onclick="UndoEdit" title="Undo Changes">↺ Undo</button>
                    <button type="button" class="btn-sm btn-secondary" @onclick="CancelEdit" title="Cancel Edit">❌ Cancel</button>
                  </td>
                }
                else
                {
                  <td><strong>@item.Name</strong></td>
                  <td class="desc">@(item.Description ?? "-")</td>
                  <td class="image-cell">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                      <img src="@item.ImageUrl" alt="@item.Name" class="item-image" />
                    }
                    else
                    {
                      <span class="no-image">🖼️</span>
                    }
                  </td>
                  <td><span class="category-tag">@item.Category?.Name</span></td>
                  <td><span class="cost">@item.Cost pts</span></td>
                  <td><span class="stock @(item.Stock <= 5 ? "low-stock" : "")">@item.Stock</span></td>
                  <td class="actions">
                    <button type="button" class="btn-sm btn-primary" @onclick="() => StartEdit(item)" title="Edit Item">✏️</button>
                    <button type="button" class="btn-sm btn-danger" @onclick="() => DeleteItem(item.Id)" title="Delete Item">🗑️</button>
                  </td>
                }
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="8" class="no-items">
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(categoryFilter))
                {
                  <span>🔍 No items match your search criteria</span>
                }
                else
                {
                  <span>📎 No items in inventory</span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
}


