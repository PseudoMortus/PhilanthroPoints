              <td><input @bind="editAdmin.Username" class="edit-input" placeholder="Username..." /></td>
              <td>
                <input @bind="editAdmin.FirstName" class="edit-input" placeholder="First Name..." />
                <input @bind="editAdmin.LastName" class="edit-input" placeholder="Last Name..." />
              </td>
              <td><input @bind="editAdmin.Email" class="edit-input" placeholder="Email..." /></td>
              <td><input @bind="editAdmin.Role" class="edit-input" placeholder="Role..." /></td>
              <td><input @bind="editAdmin.Department" class="edit-input" placeholder="Department..." /></td>
              <td>@admin.LastLoginDate.ToString("MM/dd/yyyy")</td>
              <td>
                <label><input type="checkbox" @bind="editAdmin.IsActive" /> Active</label>
              </td>
              <td class="actions">
                <button type="button" class="btn-sm btn-success" @onclick="SaveAdminEdit" title="Save Changes">✔️ Save</button>
                <button type="button" class="btn-sm btn-warning" @onclick="UndoAdminEdit" title="Undo Changes">↺ Undo</button>
                <button type="button" class="btn-sm btn-secondary" @onclick="CancelAdminEdit" title="Cancel Edit">❌ Cancel</button>
              </td>
            }
            else
            {
              <td><strong>@admin.Username</strong></td>
              <td>@admin.FirstName @admin.LastName</td>
              <td>@admin.Email</td>
              <td>@admin.Role</td>
              <td>@(admin.Department ?? "-")</td>
            <td>@admin.LastLoginDate.ToString("MM/dd/yyyy HH:mm")</td>
            <td>
              @if (admin.IsActive)
              {
                <span class="status-badge active">Active</span>
              }
              else
              {
                <span class="status-badge inactive">Inactive</span>
              }
            </td>
            <td>
              <div class="action-btns">
                <button class="btn-sm btn-edit" @onclick="() => StartEditAdmin(admin)">✏️</button>
                <button class="btn-sm btn-remove" @onclick="() => DeleteAdmin(admin.Id)">🗑️</button>
                <button class="btn-sm btn-toggle" @onclick="() => ToggleAdminStatus(admin.Id)">🔄</button>
              </div>
            </td>
            }
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

