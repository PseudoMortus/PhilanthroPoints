  void StartEditAdmin(AdminUser admin)
  {
    try
    {
      editingAdminId = admin.Id;
      
      // Store the original for comparison/undo
      originalAdmin = new AdminUser
      {
        Id = admin.Id,
        Username = admin.Username,
        PasswordHash = admin.PasswordHash,
        FirstName = admin.FirstName,
        LastName = admin.LastName,
        Email = admin.Email,
        PhoneNumber = admin.PhoneNumber,
        Role = admin.Role,
        Department = admin.Department,
        IsActive = admin.IsActive,
        CanManageInventory = admin.CanManageInventory,
        CanManageUsers = admin.CanManageUsers,
        CanViewReports = admin.CanViewReports,
        Notes = admin.Notes,
        CreatedDate = admin.CreatedDate,
        LastLoginDate = admin.LastLoginDate
      };
      
      // Copy to the edit version
      editAdmin = new AdminUser
      {
        Id = admin.Id,
        Username = admin.Username,
        PasswordHash = admin.PasswordHash,
        FirstName = admin.FirstName,
        LastName = admin.LastName,
        Email = admin.Email,
        PhoneNumber = admin.PhoneNumber,
        Role = admin.Role,
        Department = admin.Department,
        IsActive = admin.IsActive,
        CanManageInventory = admin.CanManageInventory,
        CanManageUsers = admin.CanManageUsers,
        CanViewReports = admin.CanViewReports,
        Notes = admin.Notes,
        CreatedDate = admin.CreatedDate,
        LastLoginDate = admin.LastLoginDate
      };
      
      status = "ï¸ Editing admin user. Make changes and click Save.";
      StateHasChanged();
    }
    catch (Exception ex)
    {
      status = $"âŒ Error starting admin edit: {ex.Message}";
    }
  }

  async Task SaveAdminEdit()
  {
    try
    {
      var success = await AdminSvc.UpdateAdminUserAsync(editAdmin);
      if (success)
      {
        status = $"… Admin user '{editAdmin.FirstName} {editAdmin.LastName}' updated successfully!";
        editingAdminId = 0;
        editAdmin = new();
        originalAdmin = new();
        await RefreshAdminData();
      }
      else
      {
        status = "âŒ Failed to update admin user.";
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error updating admin: {ex.Message}";
    }
  }

  void UndoAdminEdit()
  {
    try
    {
      editAdmin = new AdminUser
      {
        Id = originalAdmin.Id,
        Username = originalAdmin.Username,
        PasswordHash = originalAdmin.PasswordHash,
        FirstName = originalAdmin.FirstName,
        LastName = originalAdmin.LastName,
        Email = originalAdmin.Email,
        PhoneNumber = originalAdmin.PhoneNumber,
        Role = originalAdmin.Role,
        Department = originalAdmin.Department,
        IsActive = originalAdmin.IsActive,
        CanManageInventory = originalAdmin.CanManageInventory,
        CanManageUsers = originalAdmin.CanManageUsers,
        CanViewReports = originalAdmin.CanViewReports,
        Notes = originalAdmin.Notes,
        CreatedDate = originalAdmin.CreatedDate,
        LastLoginDate = originalAdmin.LastLoginDate
      };
      status = "â†¶ Admin changes undone.";
      StateHasChanged();
    }
    catch (Exception ex)
    {
      status = $"âŒ Error undoing admin changes: {ex.Message}";
    }
  }

  void CancelAdminEdit()
  {
    editingAdminId = 0;
    editAdmin = new();
    originalAdmin = new();
    status = "âŒ Admin edit cancelled.";
    StateHasChanged();
  }

  async Task DeleteUser(int userId)
  {
    try
    {
      var success = await UserSvc.DeleteUserAsync(userId);
      if (success)
      {
        status = "… User deleted successfully!";
        await RefreshUsersData();
      }
      else
      {
        status = "âŒ Failed to delete user.";
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error deleting user: {ex.Message}";
    }
  }

  async Task DeleteAdmin(int adminId)
  {
    try
    {
      var admin = adminUsers.FirstOrDefault(a => a.Id == adminId);
      if (admin == null)
      {
        status = "âŒ Admin user not found.";
        return;
      }

      // Store the admin for potential undo
      lastDeletedAdmin = new AdminUser
      {
        Id = admin.Id,
        Username = admin.Username,
        PasswordHash = admin.PasswordHash,
        FirstName = admin.FirstName,
        LastName = admin.LastName,
        Email = admin.Email,
        PhoneNumber = admin.PhoneNumber,
        Role = admin.Role,
        Department = admin.Department,
        IsActive = admin.IsActive,
        CanManageInventory = admin.CanManageInventory,
        CanManageUsers = admin.CanManageUsers,
        CanViewReports = admin.CanViewReports,
        Notes = admin.Notes,
        CreatedDate = admin.CreatedDate,
        LastLoginDate = admin.LastLoginDate
      };
      adminDeletedTime = DateTime.Now;
      
      var success = await AdminSvc.DeleteAdminUserAsync(adminId);
      if (success)
      {
        status = $"… Admin user '{admin.FirstName} {admin.LastName}' deleted successfully! You have {undoTimeLimit.TotalMinutes} minutes to undo.";
        await RefreshAdminData();
      }
      else
      {
        status = "âŒ Failed to delete admin user.";
        lastDeletedAdmin = null;
        adminDeletedTime = null;
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error deleting admin: {ex.Message}";
      lastDeletedAdmin = null;
      adminDeletedTime = null;
    }
  }

  async Task UndoAdminDeletion()
  {
    if (lastDeletedAdmin == null || adminDeletedTime == null)
    {
      status = "âŒ No recent admin deletion to undo.";
      return;
    }

    if (DateTime.Now - adminDeletedTime.Value > undoTimeLimit)
    {
      status = "âŒ Undo time limit expired. Cannot restore deleted admin.";
      lastDeletedAdmin = null;
      adminDeletedTime = null;
      return;
    }

    try
    {
      // Create new admin with same properties (but new ID will be assigned)
      var restoredAdmin = new AdminUser
      {
        Username = lastDeletedAdmin.Username + "_restored", // Modify username slightly to avoid conflicts
        PasswordHash = lastDeletedAdmin.PasswordHash,
        FirstName = lastDeletedAdmin.FirstName,
        LastName = lastDeletedAdmin.LastName,
        Email = lastDeletedAdmin.Email.Replace("@", "+restored@"), // Modify email to avoid conflicts
        PhoneNumber = lastDeletedAdmin.PhoneNumber,
        Role = lastDeletedAdmin.Role,
        Department = lastDeletedAdmin.Department,
        IsActive = lastDeletedAdmin.IsActive,
        CanManageInventory = lastDeletedAdmin.CanManageInventory,
        CanManageUsers = lastDeletedAdmin.CanManageUsers,
        CanViewReports = lastDeletedAdmin.CanViewReports,
        Notes = $"Restored from deletion on {DateTime.Now:yyyy-MM-dd HH:mm}. Original notes: {lastDeletedAdmin.Notes}",
        CreatedDate = DateTime.Now,
        LastLoginDate = DateTime.Now
      };

      var success = await AdminSvc.CreateAdminUserAsync(restoredAdmin);
      if (success)
      {
        status = $"… Admin user '{lastDeletedAdmin.FirstName} {lastDeletedAdmin.LastName}' restored successfully! Username: {restoredAdmin.Username}";
        lastDeletedAdmin = null;
        adminDeletedTime = null;
        await RefreshAdminData();
      }
      else
      {
        status = "âŒ Failed to restore deleted admin user. Username or email may already exist.";
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error restoring admin: {ex.Message}";
    }
  }

  async Task AddPointsToUser(int userId, int points)
  {
    try
    {
      var success = await UserSvc.AddPointsAsync(userId, points);
      if (success)
      {
        status = $"… Added {points} points to user!";
        await RefreshUsersData();
      }
      else
      {
        status = "âŒ Failed to add points to user.";
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error adding points: {ex.Message}";
    }
  }

  async Task ToggleAdminStatus(int adminId)
  {
    try
    {
      var admin = adminUsers.FirstOrDefault(a => a.Id == adminId);
      if (admin != null)
      {
        admin.IsActive = !admin.IsActive;
        var success = await AdminSvc.UpdateAdminUserAsync(admin);
        if (success)
        {
          status = $"… Admin status toggled successfully!";
          await RefreshAdminData();
        }
        else
        {
          status = "âŒ Failed to toggle admin status.";
        }
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error toggling admin status: {ex.Message}";
    }
  }
  
