@code {
  private string activeTab = "inventory";
  private List<Item> items = new();
  private List<Item> filtered = new();
  private List<Category> categories = new();
  private List<Member> members = new();
  private List<User> users = new();
  private List<AdminUser> adminUsers = new();
  private List<Family> families = new();
  
  // Undo functionality - store recently deleted items
  private Item? lastDeletedItem = null;
  private AdminUser? lastDeletedAdmin = null;
  private Member? lastDeletedMember = null;
  private User? lastDeletedUser = null;
  private Family? lastDeletedFamily = null;
  private DateTime? itemDeletedTime = null;
  private DateTime? adminDeletedTime = null;
  private DateTime? memberDeletedTime = null;
  private DateTime? userDeletedTime = null;
  private DateTime? familyDeletedTime = null;
  private readonly TimeSpan undoTimeLimit = TimeSpan.FromMinutes(5); // 5 minute undo window
  
  private Dictionary<int, int> pointsInputs = new();
  private string? search;
  private string? categoryFilter;
  private string? status;
  private bool showAddForm = false;
  private bool showAddUserForm = false;
  private bool showAddAdminForm = false;
  private bool isSubmitting = false;
  private bool isRefreshing = false;
  
  // Monitor variables
  private List<Item>? lowStockItems = new();
  private List<Item>? outOfStockItems = new();
  private Dictionary<string, int>? stockSummary = new();
  private DateTime lastMonitorUpdate = DateTime.Now;
  
  // User management
  private User newUser = new();
  private AdminUser newAdmin = new();
  private string tempPassword = "";
  
  // Family management
  private Family? selectedFamily = null;
  
  private int editingItemId = 0;
  private int editingAdminId = 0;
  private Item editItem = new();
  private AdminUser editAdmin = new();
  private Item originalItem = new(); // For undo functionality
  private AdminUser originalAdmin = new(); // For undo functionality
  private Item newItem = new();

  protected override async Task OnInitializedAsync()
  {
    await RefreshData();
  }

  async Task RefreshData()
  {
    categories = await Catalog.CategoriesAsync();
    items = await Catalog.AllAsync();
    members = PointsSvc.GetAllMembers();
    users = await UserSvc.GetAllUsersAsync();
    adminUsers = await AdminSvc.GetAllAdminUsersAsync();
    
    // Load families from database
    families = DbContext.Families.ToList();
    
    // Initialize points inputs
    foreach (var m in members)
    {
      pointsInputs[m.Id] = 10;
    }
    
    await ApplyFilters();
    StateHasChanged();
  }
  
  async Task ForceRefresh()
  {
    isRefreshing = true;
    status = "ðŸ”„ Refreshing data from database...";
    StateHasChanged();
    
    try
    {
      // Cancel any ongoing edits first
      editingItemId = 0;
      editItem = new();
      originalItem = new();
      showAddForm = false;
      
      // Clear current data
      items.Clear();
      categories.Clear();
      members.Clear();
      filtered.Clear();
      
      // Force UI update to show cleared state
      StateHasChanged();
      
      // Small delay to show the clearing
      await Task.Delay(100);
      
      // Refresh from database
      categories = await Catalog.CategoriesAsync();
      items = await Catalog.AllAsync();
      members = PointsSvc.GetAllMembers();
      
      // Reinitialize points inputs
      pointsInputs.Clear();
      foreach (var m in members)
      {
        pointsInputs[m.Id] = 10;
      }
      
      // Apply current filters
      await ApplyFilters();
      
      status = "… Data refreshed successfully!";
      
      // Clear status after a delay
      await Task.Delay(2000);
      if (status?.Contains("refreshed successfully") == true)
      {
        status = null;
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error refreshing data: {ex.Message}";
      Console.WriteLine($"ForceRefresh Error: {ex}");
    }
    finally
    {
      isRefreshing = false;
      StateHasChanged();
    }
  }

  void SetTab(string tab)
  {
    activeTab = tab;
    status = null;
    showAddForm = false; // Hide form when switching tabs
    editingItemId = 0;   // Cancel any ongoing edits
    
    // Set category filter based on tab
    if (tab == "gifts") categoryFilter = "Gifts";
    else if (tab == "treats") categoryFilter = "Treats";
    else if (tab == "cards") categoryFilter = "Cards";
    else if (tab == "inventory") categoryFilter = "";
    
    if (tab == "monitor")
    {
      _ = RefreshMonitorData(); // Fire and forget
    }
    
    _ = ApplyFilters();
  }

  async Task ApplyFilters()
  {
    if (activeTab == "inventory" || activeTab == "gifts" || activeTab == "treats" || activeTab == "cards")
    {
      filtered = await Catalog.SearchItemsAsync(search ?? "", 
        activeTab == "inventory" ? categoryFilter : activeTab.Substring(0, 1).ToUpper() + activeTab.Substring(1));
    }
  }

  async Task OnSearchChanged(ChangeEventArgs e)
  {
    search = e.Value?.ToString();
    await ApplyFilters();
  }

  async Task OnCategoryChanged(ChangeEventArgs e)
  {
    categoryFilter = e.Value?.ToString();
    await ApplyFilters();
  }

  void ClearFilters()
  {
    search = "";
    categoryFilter = "";
    _ = ApplyFilters();
  }

  void ShowAddItemForm(string? categoryName = null)
  {
    showAddForm = true;
    newItem = new Item();
    
    // Auto-set category if specified
    if (!string.IsNullOrEmpty(categoryName))
    {
      var category = categories.FirstOrDefault(c => c.Name == categoryName);
      if (category != null)
      {
        newItem.CategoryId = category.Id;
      }
    }
    
    status = null;
  }

  void CancelAddItem()
  {
    showAddForm = false;
    newItem = new();
  }

  async Task SubmitNewItem()
  {
    if (newItem.CategoryId <= 0)
    {
      status = "âŒ Please select a category.";
      return;
    }

    isSubmitting = true;
    var success = await Catalog.AddItemAsync(newItem);
    isSubmitting = false;

    if (success)
    {
      status = $"… Item '{newItem.Name}' added successfully!";
      showAddForm = false;
      newItem = new();
      await RefreshData();
    }
    else
    {
      status = "âŒ Failed to add item. Please try again.";
    }
  }

  void StartEdit(Item item)
  {
    editingItemId = item.Id;
    // Store original item for undo functionality
    originalItem = new Item
    {
      Id = item.Id,
      Name = item.Name,
      Description = item.Description,
      ImageUrl = item.ImageUrl,
      Cost = item.Cost,
      Stock = item.Stock,
      CategoryId = item.CategoryId
    };
    // Create editable copy
    editItem = new Item
    {
      Id = item.Id,
      Name = item.Name,
      Description = item.Description,
      ImageUrl = item.ImageUrl,
      Cost = item.Cost,
      Stock = item.Stock,
      CategoryId = item.CategoryId
    };
  }

  async Task SaveEdit()
  {
    try
    {
      Console.WriteLine("SaveEdit called");
      
      // Validate input
      if (string.IsNullOrWhiteSpace(editItem.Name))
      {
        status = "âŒ Item name is required.";
        StateHasChanged();
        return;
      }
      
      if (editItem.Cost <= 0)
      {
        status = "âŒ Item cost must be greater than 0.";
        StateHasChanged();
        return;
      }
      
      if (editItem.Stock < 0)
      {
        status = "âŒ Stock cannot be negative.";
        StateHasChanged();
        return;
      }

      // Show saving status
      status = "ðŸ’¾ Saving changes...";
      StateHasChanged();
      
      Console.WriteLine($"Updating item: {editItem.Name}, Cost: {editItem.Cost}, Stock: {editItem.Stock}");
      
      // Perform the update
      var success = await Catalog.UpdateItemAsync(editItem);
      
      Console.WriteLine($"Update result: {success}");
      
      if (success)
      {
        status = $"… Item '{editItem.Name}' updated successfully!";
        
        // Exit edit mode
        editingItemId = 0;
        originalItem = new();
        
        // Refresh the data to show changes
        await RefreshData();
        
        Console.WriteLine("Save completed successfully");
      }
      else
      {
        status = "âŒ Failed to update item. Please check your input and try again.";
      }
      
      StateHasChanged();
    }
    catch (Exception ex)
    {
      status = $"âŒ Error updating item: {ex.Message}";
      Console.WriteLine($"SaveEdit Error: {ex}");
      StateHasChanged();
    }
  }

  void UndoEdit()
  {
    Console.WriteLine("UndoEdit called");
    
    // Restore original values
    editItem.Name = originalItem.Name;
    editItem.Description = originalItem.Description;
    editItem.ImageUrl = originalItem.ImageUrl;
    editItem.Cost = originalItem.Cost;
    editItem.Stock = originalItem.Stock;
    editItem.CategoryId = originalItem.CategoryId;
    
    status = "â†¶ Changes undone - original values restored.";
    StateHasChanged();
    
    Console.WriteLine("Undo completed");
  }
  
  void CancelEdit()
  {
    Console.WriteLine("CancelEdit called");
    
    editingItemId = 0;
    editItem = new();
    originalItem = new();
    status = "âŒ Edit cancelled.";
    StateHasChanged();
    
    Console.WriteLine("Cancel completed");
  }

  async Task DeleteItem(int id)
  {
    var item = items.FirstOrDefault(i => i.Id == id);
    if (item == null) return;

    try
    {
      // Store the item for potential undo
      lastDeletedItem = new Item
      {
        Id = item.Id,
        Name = item.Name,
        Description = item.Description,
        ImageUrl = item.ImageUrl,
        Cost = item.Cost,
        Stock = item.Stock,
        CategoryId = item.CategoryId,
        Category = item.Category
      };
      itemDeletedTime = DateTime.Now;
      
      // Delete from database
      var success = await Catalog.DeleteItemAsync(id);
      if (success)
      {
        status = $"… Item '{item.Name}' deleted successfully! You have {undoTimeLimit.TotalMinutes} minutes to undo.";
        await RefreshData();
      }
      else
      {
        status = "âŒ Failed to delete item.";
        lastDeletedItem = null;
        itemDeletedTime = null;
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error deleting item: {ex.Message}";
      lastDeletedItem = null;
      itemDeletedTime = null;
    }
  }

  async Task UndoItemDeletion()
  {
    if (lastDeletedItem == null || itemDeletedTime == null)
    {
      status = "âŒ No recent item deletion to undo.";
      return;
    }

    if (DateTime.Now - itemDeletedTime.Value > undoTimeLimit)
    {
      status = "âŒ Undo time limit expired. Cannot restore deleted item.";
      lastDeletedItem = null;
      itemDeletedTime = null;
      return;
    }

    try
    {
      // Create new item with same properties (but new ID will be assigned)
      var restoredItem = new Item
      {
        Name = lastDeletedItem.Name,
        Description = lastDeletedItem.Description,
        ImageUrl = lastDeletedItem.ImageUrl,
        Cost = lastDeletedItem.Cost,
        Stock = lastDeletedItem.Stock,
        CategoryId = lastDeletedItem.CategoryId
      };

      var success = await Catalog.AddItemAsync(restoredItem);
      if (success)
      {
        status = $"… Item '{lastDeletedItem.Name}' restored successfully!";
        lastDeletedItem = null;
        itemDeletedTime = null;
        await RefreshData();
      }
      else
      {
        status = "âŒ Failed to restore deleted item.";
      }
    }
    catch (Exception ex)
    {
      status = $"âŒ Error restoring item: {ex.Message}";
    }
  }

  void AddPointsToMember(int memberId, int amount = 10)
  {
    if (amount <= 0) return;
    if (amount <= 0)
    {
      status = "âš ï¸ Please enter a positive amount.";
      return;
    }
    
    if (PointsSvc.AddPoints(memberId, amount))
    {
      members = PointsSvc.GetAllMembers();
      status = $"… Added {amount} points.";
    }
    else
    {
      status = "âŒ Failed to add points.";
    }
  }

  void RemovePointsFromMember(int memberId, int amount = 10)
  {
    if (amount <= 0) return;
    if (amount <= 0)
    {
      status = "âš ï¸ Please enter a positive amount.";
      return;
    }
    
    if (PointsSvc.RemovePoints(memberId, amount))
    {
      members = PointsSvc.GetAllMembers();
      status = $"… Removed {amount} points.";
    }
    else
    {
      status = "âŒ Failed to remove points.";
    }
  }

  async Task RefreshMonitorData()
  {
    try
    {
      status = "ðŸ”„ Refreshing monitor data...";
      StateHasChanged();
      
      lowStockItems = await Monitor.GetLowStockItemsAsync(5);
      outOfStockItems = await Monitor.GetOutOfStockItemsAsync();
      stockSummary = await Monitor.GetStockSummaryAsync();
      lastMonitorUpdate = DateTime.Now;
      
      status = "… Monitor data refreshed successfully!";
      StateHasChanged();
    }
    catch (Exception ex)
    {
      status = $"âŒ Error refreshing monitor: {ex.Message}";
      StateHasChanged();
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await RefreshMonitorData();
    }
  }

  // User Management Methods
