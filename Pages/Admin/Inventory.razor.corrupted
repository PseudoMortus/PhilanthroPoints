<style>
.toolbar {
  display: flex;
  gap: 0.75rem;
  margin: 0 0 1rem 0;
  align-items: center;
  flex-wrap: wrap;
}

.toolbar input, .toolbar select {
  padding: 0.6rem 0.8rem;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-size: 0.9rem;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(10px);
  transition: all 0.2s ease;
}

.card {
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  border: 2px solid rgba(59, 130, 246, 0.1);
  border-radius: 16px;
  padding: 1.5rem;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  margin-bottom: 1.5rem;
}

.add-item-form {
  border: 2px solid #10b981;
  background: rgba(16, 185, 129, 0.05);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.form-field label {
  display: block;
  font-weight: 600;
  color: #374151;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.form-field .input {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-size: 0.9rem;
  transition: all 0.2s ease;
}

.form-actions {
  display: flex;
  gap: 1rem;
  justify-content: flex-start;
}

.inventory-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  flex-wrap: wrap;
  gap: 1rem;
}

.table-container {
  overflow-x: auto;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
}

table.inv {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
  background: white;
}

table.inv th {
  background: #f8fafc;
  text-align: left;
  padding: 1rem 0.75rem;
  border-bottom: 2px solid #e5e7eb;
  font-weight: 700;
  color: #374151;
}

table.inv td {
  padding: 0.75rem;
  vertical-align: top;
  border-bottom: 1px solid #f1f5f9;
}

table.inv tr:hover {
  background: rgba(59, 130, 246, 0.05);
}

td.id {
  font-family: ui-monospace, monospace;
  color: #6b7280;
  font-size: 0.8rem;
  width: 60px;
}

td.desc {
  max-width: 200px;
  word-wrap: break-word;
}

.actions {
  display: flex;
  gap: 0.5rem;
  justify-content: center;
  align-items: center;
}

.category-tag {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
}

.cost {
  font-weight: 700;
  color: #059669;
  font-size: 0.9rem;
}

.stock {
  font-weight: 600;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  background: #dcfce7;
  color: #166534;
}

.stock.low-stock {
  background: #fef3c7;
  color: #92400e;
}

.no-items {
  text-align: center;
  color: #6b7280;
  font-style: italic;
  padding: 2rem;
}

.edit-input, .edit-textarea, .edit-select {
  width: 100%;
  padding: 0.5rem;
  border: 2px solid #3b82f6;
  border-radius: 4px;
  font-size: 0.85rem;
  background: white;
}

.edit-input-sm {
  width: 80px;
  padding: 0.4rem;
  border: 2px solid #3b82f6;
  border-radius: 4px;
  font-size: 0.8rem;
}

.points-input {
  width: 80px;
  padding: 0.4rem;
  border: 1px solid #d1d5db;
  border-radius: 4px;
  font-size: 0.8rem;
}

.btn {
  background: #3b82f6;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 0.6rem 1.2rem;
  cursor: pointer;
  font-size: 0.9rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn:hover {
  background: #2563eb;
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
}

.btn-success {
  background: linear-gradient(135deg, #10b981, #059669);
}

.btn-secondary {
  background: #6b7280;
}

.btn-danger {
  background: #ef4444;
}

.btn-warning {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
}

.btn-refresh {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  color: white;
}

.btn-refresh:hover {
  background: linear-gradient(135deg, #7c3aed, #6d28d9);
}

.btn-warning:hover {
  background: linear-gradient(135deg, #d97706, #b45309);
}

.btn-sm {
  border: none;
  border-radius: 6px;
  padding: 0.4rem 0.6rem;
  cursor: pointer;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.btn-add {
  background: #10b981;
  color: white;
}

.btn-remove {
  background: #ef4444;
  color: white;
}

.admin-menu {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  margin: 1rem 0 2rem 0;
  flex-wrap: wrap;
}

.menu-link {
  color: #374151;
  text-decoration: none;
  padding: 0.6rem 1rem;
  border-radius: 8px;
  border: 2px solid #e5e7eb;
  background: rgba(255,255,255,0.8);
  transition: all 0.2s ease;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.9rem;
