            </label>
            <label class="checkbox-label">
              <InputCheckbox @bind-Value="newAdmin.CanManageUsers" />
              Can Manage Users
            </label>
            <label class="checkbox-label">
              <InputCheckbox @bind-Value="newAdmin.CanViewReports" />
              Can View Reports
            </label>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-success">… Create Admin</button>
          <button type="button" class="btn btn-secondary" @onclick="CancelAddAdmin">âŒ Cancel</button>
        </div>
      </EditForm>
    </div>
  }

  <div class="table-container">
    <table class="inv">
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Department</th>
          <th>Last Login</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var admin in adminUsers)
        {
          <tr class="@(editingAdminId == admin.Id ? "editing" : "")">
            <td class="id">@admin.Id</td>
            @if (editingAdminId == admin.Id)
            {
              <td><input @bind="editAdmin.Username" class="edit-input" placeholder="Username" /></td>
              <td>
                <input @bind="editAdmin.FirstName" class="edit-input-sm" placeholder="First Name" />
                <input @bind="editAdmin.LastName" class="edit-input-sm" placeholder="Last Name" />
              </td>
              <td><input @bind="editAdmin.Email" class="edit-input" placeholder="Email" /></td>
              <td>
                <select @bind="editAdmin.Role" class="edit-select">
                  <option value="Admin">Admin</option>
                  <option value="Super Admin">Super Admin</option>
                  <option value="Moderator">Moderator</option>
                  <option value="Manager">Manager</option>
                </select>
              </td>
              <td><input @bind="editAdmin.Department" class="edit-input" placeholder="Department" /></td>
              <td><span class="edit-readonly">@admin.LastLoginDate.ToString("MM/dd/yyyy HH:mm")</span></td>
              <td>
                <select @bind="editAdmin.IsActive" class="edit-select">
                  <option value="true">Active</option>
                  <option value="false">Inactive</option>
                </select>
              </td>
              <td class="actions">
                <button type="button" class="btn-sm btn-success" @onclick="SaveAdminEdit" title="Save Changes">ðŸ’¾ Save</button>
                <button type="button" class="btn-sm btn-warning" @onclick="UndoAdminEdit" title="Undo Changes">â†¶ Undo</button>
                <button type="button" class="btn-sm btn-secondary" @onclick="CancelAdminEdit" title="Cancel Edit">âŒ Cancel</button>
              </td>
            }
            else
            {
              <td><strong>@admin.Username</strong></td>
              <td>@admin.FirstName @admin.LastName</td>
              <td>@admin.Email</td>
              <td>@admin.Role</td>
              <td>@(admin.Department ?? "â€”")</td>
              <td>@admin.LastLoginDate.ToString("MM/dd/yyyy HH:mm")</td>
              <td>
                @if (admin.IsActive)
                {
                  <span class="status-badge active">Active</span>
                }
                else
                {
                  <span class="status-badge inactive">Inactive</span>
                }
              </td>
              <td>
                <div class="action-btns">
                  <button class="btn-sm btn-edit" @onclick="() => StartEditAdmin(admin)">ï¸</button>
                  <button class="btn-sm btn-remove" @onclick="() => DeleteAdmin(admin.Id)">ðŸ—‘ï¸</button>
                  <button class="btn-sm btn-toggle" @onclick="() => ToggleAdminStatus(admin.Id)">ðŸ”„</button>
                </div>
              </td>
            }
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

