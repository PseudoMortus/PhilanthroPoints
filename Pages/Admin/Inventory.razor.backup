
@page "/admin/inventory"
@using Microsoft.AspNetCore.Authorization
@using PhilanthroPoints.Models
@attribute [Authorize(Roles="Admin")]
@inject PhilanthroPoints.Services.CatalogService Catalog
@inject PhilanthroPoints.Services.PointsService PointsSvc
@inject PhilanthroPoints.Services.CartMonitorService Monitor
@inject PhilanthroPoints.Services.UserService UserSvc
@inject PhilanthroPoints.Services.AdminUserService AdminSvc
@inject PhilanthroPoints.Data.ApplicationDbContext DbContext

<h2>Admin — Inventory Management</h2>
<nav class="admin-menu">
  <a class="menu-link @(activeTab == "inventory" ? "active" : "")" href="#" @onclick='() => SetTab("inventory")'>📦 Inventory</a>
  <a class="menu-link @(activeTab == "families" ? "active" : "")" href="#" @onclick='() => SetTab("families")'>👨‍👩‍👧‍👦 Families</a>
  <a class="menu-link @(activeTab == "members" ? "active" : "")" href="#" @onclick='() => SetTab("members")'>👥 Members</a>
  <a class="menu-link @(activeTab == "users" ? "active" : "")" href="#" @onclick='() => SetTab("users")'>👤 Users</a>
  <a class="menu-link @(activeTab == "adminusers" ? "active" : "")" href="#" @onclick='() => SetTab("adminusers")'>🔐 Admin Users</a>
  <a class="menu-link @(activeTab == "monitor" ? "active" : "")" href="#" @onclick='() => SetTab("monitor")'>📊 Cart Monitor</a>
  <a class="menu-link @(activeTab == "gifts" ? "active" : "")" href="#" @onclick='() => SetTab("gifts")'>🎁 Gifts</a>
  <a class="menu-link @(activeTab == "treats" ? "active" : "")" href="#" @onclick='() => SetTab("treats")'>🍭 Treats</a>
  <a class="menu-link @(activeTab == "cards" ? "active" : "")" href="#" @onclick='() => SetTab("cards")'>💌 Cards</a>
  <span class="spacer"></span>
  <a class="menu-link" href="/">🏠 Back to Site</a>
  @if(!string.IsNullOrWhiteSpace(status)) { <span class="status">@status</span> }
</nav>

@if (activeTab == "inventory")
{
<div class="toolbar">
  <input @bind="search" @oninput="OnSearchChanged" placeholder="🔍 Search items..." />
  <select value="@categoryFilter" @onchange="OnCategoryChanged">
    <option value="">All Categories</option>
    @foreach (var c in categories)
    {
      <option value="@c.Name">@c.Name</option>
    }
  </select>
  <button type="button" class="btn btn-primary" @onclick="() => ShowAddItemForm()">➕ Add Item</button>
  <button type="button" class="btn btn-refresh" @onclick="ForceRefresh" disabled="@isRefreshing" title="Refresh all data from database">
    @if (isRefreshing) { <span>⏳ Refreshing...</span> } else { <span>🔄 Refresh</span> }
  </button>
</div>
}

@if (showAddForm)
{
<div class="add-item-form card">
  <h3>➕ Add New Item</h3>
  <EditForm Model="newItem" OnValidSubmit="SubmitNewItem">
    <DataAnnotationsValidator />
    <div class="form-grid">
      <div class="form-field">
        <label>Name *</label>
        <InputText @bind-Value="newItem.Name" class="input" placeholder="Enter item name..." />
        <ValidationMessage For="@(() => newItem.Name)" />
      </div>
      <div class="form-field">
        <label>Description</label>
        <InputTextArea @bind-Value="newItem.Description" class="input textarea" rows="3" placeholder="Enter item description..." />
      </div>
      <div class="form-field">
        <label>Image URL</label>
        <InputText @bind-Value="newItem.ImageUrl" class="input" placeholder="Enter image URL..." />
      </div>
      <div class="form-field">
        <label>Category *</label>
        <InputSelect @bind-Value="newItem.CategoryId" class="input">
          <option value="0">-- Select Category --</option>
          @foreach (var c in categories)
          {
            <option value="@c.Id">@c.Name</option>
          }
        </InputSelect>
        <ValidationMessage For="@(() => newItem.CategoryId)" />
      </div>
      <div class="form-field">
        <label>Cost (Points) *</label>
        <InputNumber @bind-Value="newItem.Cost" class="input" min="1" placeholder="0" />
        <ValidationMessage For="@(() => newItem.Cost)" />
      </div>
      <div class="form-field">
        <label>Stock *</label>
        <InputNumber @bind-Value="newItem.Stock" class="input" min="0" placeholder="0" />
        <ValidationMessage For="@(() => newItem.Stock)" />
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-success" disabled="@isSubmitting">
        @if (isSubmitting) { <span>⏳ Adding...</span> } else { <span>✅ Submit Item</span> }
      </button>
      <button type="button" class="btn btn-secondary" @onclick="CancelAddItem">❌ Cancel</button>
    </div>
  </EditForm>
</div>
}

@if (activeTab == "inventory")
{
<div class="card">
  <div class="inventory-header">
    <h3>📦 Inventory Items (@filtered.Count)</h3>
    @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(categoryFilter))
    {
      <span class="filter-info">
        @if (!string.IsNullOrEmpty(search)) { <span>🔍 "@search"</span> }
        @if (!string.IsNullOrEmpty(categoryFilter)) { <span>📂 @categoryFilter</span> }
        <button class="btn-link" @onclick="ClearFilters">Clear filters</button>
      </span>
    }
  </div>
  <div class="table-container">
    <table class="inv">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Description</th>
          <th>Image</th>
          <th>Category</th>
          <th>Cost</th>
          <th>Stock</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @if (filtered.Any())
        {
          @foreach (var item in filtered)
          {
            <tr class="@(editingItemId == item.Id ? "editing" : "")">
              <td class="id">@item.Id</td>
              @if (editingItemId == item.Id)
              {
                <td><input @bind="editItem.Name" @bind:event="oninput" class="edit-input" placeholder="Item name..." /></td>
                <td><textarea @bind="editItem.Description" @bind:event="oninput" class="edit-textarea" rows="2" placeholder="Description..."></textarea></td>
                <td><input @bind="editItem.ImageUrl" @bind:event="oninput" class="edit-input" placeholder="Image URL..." /></td>
                <td>
                  <select @bind="editItem.CategoryId" @bind:event="onchange" class="edit-select">
                    @foreach (var c in categories)
                    {
                      <option value="@c.Id" selected="@(editItem.CategoryId == c.Id)">@c.Name</option>
                    }
                  </select>
                </td>
                <td><input type="number" @bind="editItem.Cost" @bind:event="oninput" class="edit-input-sm" min="1" step="1" placeholder="Cost" /></td>
                <td><input type="number" @bind="editItem.Stock" @bind:event="oninput" class="edit-input-sm" min="0" step="1" placeholder="Stock" /></td>
                <td class="actions">
                  <button type="button" class="btn-sm btn-success" @onclick="SaveEdit" title="Save Changes">💾 Save</button>
                  <button type="button" class="btn-sm btn-warning" @onclick="UndoEdit" title="Undo Changes">↶ Undo</button>
                  <button type="button" class="btn-sm btn-secondary" @onclick="CancelEdit" title="Cancel Edit">❌ Cancel</button>
                </td>
              }
              else
              {
                <td><strong>@item.Name</strong></td>
                <td class="desc">@(item.Description ?? "—")</td>
                <td class="image-cell">
                  @if (!string.IsNullOrEmpty(item.ImageUrl))
                  {
                    <img src="@item.ImageUrl" alt="@item.Name" class="item-image" />
                  }
                  else
                  {
                    <span class="no-image">📷</span>
                  }
                </td>
                <td><span class="category-tag">@item.Category?.Name</span></td>
                <td><span class="cost">@item.Cost pts</span></td>
                <td><span class="stock @(item.Stock <= 5 ? "low-stock" : "")">@item.Stock</span></td>
                <td class="actions">
                  <button type="button" class="btn-sm btn-primary" @onclick="() => StartEdit(item)" title="Edit Item">✏️</button>
                  <button type="button" class="btn-sm btn-danger" @onclick="() => DeleteItem(item.Id)" title="Delete Item">🗑️</button>
                </td>
              }
            </tr>
          }
        }
        else
        {
          <tr>
            <td colspan="8" class="no-items">
              @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(categoryFilter))
              {
                <span>🔍 No items match your search criteria</span>
              }
              else
              {
                <span>📦 No items in inventory</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

@if (activeTab == "families")
{
<div class="card">
  <h3>👨‍👩‍👧‍👦 Family Demographics</h3>
  
  @if (families.Any())
  {
    <div class="table-container">
      <table class="inv">
        <thead>
          <tr>
            <th>ID</th>
            <th>Family Name</th>
            <th>Child Info</th>
            <th>Contact</th>
            <th>Dietary Needs</th>
            <th>Survey</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var family in families)
          {
            <tr>
              <td class="id">@family.Id</td>
              <td>
                <strong>@family.FamilyName</strong>
                @if (!string.IsNullOrEmpty(family.HeadOfHousehold))
                {
                  <br /><small>Head: @family.HeadOfHousehold</small>
                }
              </td>
              <td>
                @if (family.Age.HasValue)
                {
                  <span>Age: @family.Age</span>
                }
                @if (family.Birthday.HasValue)
                {
                  <br /><small>Birthday: @family.Birthday.Value.ToString("MM/dd/yyyy")</small>
                }
                @if (!string.IsNullOrEmpty(family.Ethnicity))
                {
                  <br /><small>Ethnicity: @family.Ethnicity</small>
                }
              </td>
              <td>
                @if (!string.IsNullOrEmpty(family.ContactPhone))
                {
                  <div>📞 @family.ContactPhone</div>
                }
                @if (!string.IsNullOrEmpty(family.ContactEmail))
                {
                  <div>✉️ @family.ContactEmail</div>
                }
                @if (!string.IsNullOrEmpty(family.Address))
                {
                  <small>@family.Address<br />@family.City, @family.State @family.Zip</small>
                }
              </td>
              <td>
                @{
                  var dietaryNeeds = new List<string>();
                  if (family.GlutenFree) dietaryNeeds.Add("Gluten Free");
                  if (family.EggFree) dietaryNeeds.Add("Egg Free");
                  if (family.LactoseFree) dietaryNeeds.Add("Lactose Free");
                  if (family.NutFree) dietaryNeeds.Add("Nut Free");
                }
                @if (dietaryNeeds.Any())
                {
                  foreach (var need in dietaryNeeds)
                  {
                    <span class="dietary-tag">@need</span>
                  }
                }
                else
                {
                  <span class="text-muted">None specified</span>
                }
                @if (!string.IsNullOrEmpty(family.OtherDietaryRestrictions))
                {
                  <br /><small>Other: @family.OtherDietaryRestrictions</small>
                }
              </td>
              <td class="text-center">
                @if (family.WillingToTakeSurvey)
                {
                  <span class="survey-yes">✅ Yes</span>
                }
                else
                {
                  <span class="survey-no">❌ No</span>
                }
              </td>
              <td>
                <div class="action-btns">
                  <button class="btn-sm btn-info" @onclick="() => ShowFamilyDetails(family.Id)" title="View Details">
                    👁️ View
                  </button>
                  <button class="btn-sm btn-primary" @onclick="() => EditFamily(family.Id)" title="Edit Family">
                    ✏️ Edit
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
  else
  {
    <div class="empty-state">
      <h4>No Family Information Available</h4>
      <p>Families will appear here once they complete the demographics form.</p>
    </div>
  }
</div>

@if (selectedFamily != null)
{
  <div class="card family-details">
    <h3>👨‍👩‍👧‍👦 Family Details: @selectedFamily.FamilyName</h3>
    
    <div class="family-detail-grid">
      <div class="detail-section">
        <h4>👶 Child Information</h4>
        <div class="detail-item">
          <strong>Age:</strong> @(selectedFamily.Age?.ToString() ?? "Not specified")
        </div>
        <div class="detail-item">
          <strong>Birthday:</strong> @(selectedFamily.Birthday?.ToString("MMMM dd, yyyy") ?? "Not specified")
        </div>
        <div class="detail-item">
          <strong>Ethnicity:</strong> @(string.IsNullOrEmpty(selectedFamily.Ethnicity) ? "Not specified" : selectedFamily.Ethnicity)
        </div>
      </div>
      
      <div class="detail-section">
        <h4>📞 Contact Information</h4>
        <div class="detail-item">
          <strong>Head of Household:</strong> @(string.IsNullOrEmpty(selectedFamily.HeadOfHousehold) ? "Not specified" : selectedFamily.HeadOfHousehold)
        </div>
        <div class="detail-item">
          <strong>Phone:</strong> @(string.IsNullOrEmpty(selectedFamily.ContactPhone) ? "Not specified" : selectedFamily.ContactPhone)
        </div>
        <div class="detail-item">
          <strong>Email:</strong> @(string.IsNullOrEmpty(selectedFamily.ContactEmail) ? "Not specified" : selectedFamily.ContactEmail)
        </div>
        <div class="detail-item">
          <strong>Address:</strong> 
          @if (!string.IsNullOrEmpty(selectedFamily.Address))
          {
            <span>@selectedFamily.Address<br />@selectedFamily.City, @selectedFamily.State @selectedFamily.Zip</span>
          }
          else
          {
            <span>Not specified</span>
          }
        </div>
      </div>
      
      <div class="detail-section">
        <h4>🎁 Gift Preferences & Impact</h4>
        <div class="detail-item">
          <strong>Preferred Gifts:</strong>
          <div class="detail-content">@(string.IsNullOrEmpty(selectedFamily.PreferredGifts) ? "Not specified" : selectedFamily.PreferredGifts)</div>
        </div>
        <div class="detail-item">
          <strong>Expected Impact:</strong>
          <div class="detail-content">@(string.IsNullOrEmpty(selectedFamily.ExpectedImpact) ? "Not specified" : selectedFamily.ExpectedImpact)</div>
        </div>
        <div class="detail-item">
          <strong>Anticipated Child Response:</strong>
          <div class="detail-content">@(string.IsNullOrEmpty(selectedFamily.AnticipatedChildResponse) ? "Not specified" : selectedFamily.AnticipatedChildResponse)</div>
        </div>
      </div>
      
      <div class="detail-section">
        <h4>🍎 Dietary Requirements</h4>
        <div class="dietary-tags">
          @if (selectedFamily.GlutenFree) { <span class="dietary-tag active">Gluten Free</span> }
          @if (selectedFamily.EggFree) { <span class="dietary-tag active">Egg Free</span> }
          @if (selectedFamily.LactoseFree) { <span class="dietary-tag active">Lactose Free</span> }
          @if (selectedFamily.NutFree) { <span class="dietary-tag active">Nut Free</span> }
          @if (!selectedFamily.GlutenFree && !selectedFamily.EggFree && !selectedFamily.LactoseFree && !selectedFamily.NutFree)
          {
            <span class="text-muted">No restrictions specified</span>
          }
        </div>
        @if (!string.IsNullOrEmpty(selectedFamily.OtherDietaryRestrictions))
        {
          <div class="detail-item">
            <strong>Other Restrictions:</strong>
            <div class="detail-content">@selectedFamily.OtherDietaryRestrictions</div>
          </div>
        }
      </div>
      
      <div class="detail-section">
        <h4>📋 Additional Information</h4>
        <div class="detail-item">
          <strong>Survey Participation:</strong> @(selectedFamily.WillingToTakeSurvey ? "✅ Willing to participate" : "❌ Not interested")
        </div>
        @if (!string.IsNullOrEmpty(selectedFamily.SpecialNotes))
        {
          <div class="detail-item">
            <strong>Special Notes:</strong>
            <div class="detail-content">@selectedFamily.SpecialNotes</div>
          </div>
        }
      </div>
    </div>
    
    <div class="detail-actions">
      <button class="btn btn-secondary" @onclick="() => selectedFamily = null">Close Details</button>
    </div>
  </div>
}
}

@if (activeTab == "members")
{
<div class="card">
  <h3>👥 Manage Member Points</h3>
  <div class="table-container">
    <table class="inv">
      <thead><tr><th>ID</th><th>Username</th><th>Name</th><th>Email</th><th>Points</th><th>Actions</th></tr></thead>
      <tbody>
        @foreach (var m in members)
        {
          <tr>
            <td class="id">@m.Id</td>
            <td><strong>@m.Username</strong></td>
            <td>@m.FirstName @m.LastName</td>
            <td>@m.Email</td>
            <td><strong class="points">@m.Points</strong></td>
            <td>
              <div class="action-btns">
                <input type="number" @bind="pointsInputs[m.Id]" placeholder="Amount" class="points-input" />
                <button class="btn-sm btn-add" @onclick="() => AddPointsToMember(m.Id)">➕</button>
                <button class="btn-sm btn-remove" @onclick="() => RemovePointsFromMember(m.Id)">➖</button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

@if (activeTab == "monitor")
{
<div class="card">
  <h3>📊 Cart & Stock Monitor</h3>
  <div class="monitor-grid">
    <div class="monitor-card">
      <h4>📉 Low Stock Alert (≤5 items)</h4>
      @if (lowStockItems?.Any() == true)
      {
        <div class="alert-list">
          @foreach (var item in lowStockItems)
          {
            <div class="alert-item low-stock">
              <span class="item-name">@item.Name (@item.Category?.Name)</span>
              <span class="stock-count">@item.Stock left</span>
            </div>
          }
        </div>
      }
      else
      {
        <p class="no-alerts">✅ All items have sufficient stock!</p>
      }
    </div>
    
    <div class="monitor-card">
      <h4>❌ Out of Stock</h4>
      @if (outOfStockItems?.Any() == true)
      {
        <div class="alert-list">
          @foreach (var item in outOfStockItems)
          {
            <div class="alert-item out-of-stock">
              <span class="item-name">@item.Name (@item.Category?.Name)</span>
              <span class="stock-count">SOLD OUT</span>
            </div>
          }
        </div>
      }
      else
      {
        <p class="no-alerts">✅ No items out of stock!</p>
      }
    </div>
    
    <div class="monitor-card">
      <h4>📊 Stock Summary by Category</h4>
      @if (stockSummary?.Any() == true)
      {
        <div class="summary-list">
          @foreach (var category in stockSummary)
          {
            <div class="summary-item">
              <span class="category-name">@category.Key</span>
              <span class="total-stock">@category.Value items</span>
            </div>
          }
        </div>
      }
      else
      {
        <p class="no-alerts">Loading summary...</p>
      }
    </div>
  </div>
  
  <div class="monitor-actions">
    <button class="btn btn-primary" @onclick="RefreshMonitorData">🔄 Refresh Monitor</button>
    <span class="last-updated">Last updated: @lastMonitorUpdate.ToString("HH:mm:ss")</span>
  </div>
</div>
}

@if (activeTab == "users")
{
<div class="card">
  <h3>👤 Manage Users</h3>
  <div class="toolbar">
    <button class="btn btn-primary" @onclick="ShowAddUserForm">➕ Add New User</button>
    <button class="btn btn-refresh" @onclick="RefreshUsersData">🔄 Refresh Users</button>
  </div>

  @if (showAddUserForm)
  {
    <div class="add-form">
      <h4>Add New User</h4>
      <EditForm Model="newUser" OnValidSubmit="CreateUser">
        <div class="form-grid">
          <div class="form-field">
            <label>Username *</label>
            <InputText @bind-Value="newUser.Username" class="input" />
          </div>
          <div class="form-field">
            <label>Email *</label>
            <InputText @bind-Value="newUser.Email" class="input" />
          </div>
          <div class="form-field">
            <label>First Name *</label>
            <InputText @bind-Value="newUser.FirstName" class="input" />
          </div>
          <div class="form-field">
            <label>Last Name *</label>
            <InputText @bind-Value="newUser.LastName" class="input" />
          </div>
          <div class="form-field">
            <label>Phone</label>
            <InputText @bind-Value="newUser.PhoneNumber" class="input" />
          </div>
          <div class="form-field">
            <label>Date of Birth</label>
            <InputDate @bind-Value="newUser.DateOfBirth" class="input" />
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-success">✅ Create User</button>
          <button type="button" class="btn btn-secondary" @onclick="CancelAddUser">❌ Cancel</button>
        </div>
      </EditForm>
    </div>
  }

  <div class="table-container">
    <table class="inv">
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Name</th>
          <th>Email</th>
          <th>Points</th>
          <th>Created</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var user in users)
        {
          <tr>
            <td class="id">@user.Id</td>
            <td><strong>@user.Username</strong></td>
            <td>@user.FirstName @user.LastName</td>
            <td>@user.Email</td>
            <td><strong class="points">@user.Points</strong></td>
            <td>@user.CreatedDate.ToString("MM/dd/yyyy")</td>
            <td>
              @if (user.IsActive)
              {
                <span class="status-badge active">Active</span>
              }
              else
              {
                <span class="status-badge inactive">Inactive</span>
              }
            </td>
            <td>
              <div class="action-btns">
                <button class="btn-sm btn-edit" @onclick="() => StartEditUser(user)">✏️</button>
                <button class="btn-sm btn-remove" @onclick="() => DeleteUser(user.Id)">🗑️</button>
                <button class="btn-sm btn-add" @onclick="() => AddPointsToUser(user.Id, 100)">💰</button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

@if (activeTab == "adminusers")
{
<div class="card">
  <h3>🔐 Manage Admin Users</h3>
  <div class="toolbar">
    <button class="btn btn-primary" @onclick="ShowAddAdminForm">➕ Add New Admin</button>
    <button class="btn btn-refresh" @onclick="RefreshAdminData">🔄 Refresh Admins</button>
  </div>

  @if (showAddAdminForm)
  {
    <div class="add-form">
      <h4>Add New Admin User</h4>
      <EditForm Model="newAdmin" OnValidSubmit="CreateAdmin">
        <div class="form-grid">
          <div class="form-field">
            <label>Username *</label>
            <InputText @bind-Value="newAdmin.Username" class="input" />
          </div>
          <div class="form-field">
            <label>Email *</label>
            <InputText @bind-Value="newAdmin.Email" class="input" />
          </div>
          <div class="form-field">
            <label>Password *</label>
            <InputText @bind-Value="tempPassword" type="password" class="input" />
          </div>
          <div class="form-field">
            <label>First Name *</label>
            <InputText @bind-Value="newAdmin.FirstName" class="input" />
          </div>
          <div class="form-field">
            <label>Last Name *</label>
            <InputText @bind-Value="newAdmin.LastName" class="input" />
          </div>
          <div class="form-field">
            <label>Role</label>
            <InputText @bind-Value="newAdmin.Role" class="input" />
          </div>
          <div class="form-field">
            <label>Department</label>
            <InputText @bind-Value="newAdmin.Department" class="input" />
          </div>
          <div class="form-field">
            <label>Phone</label>
            <InputText @bind-Value="newAdmin.PhoneNumber" class="input" />
          </div>
        </div>
        <div class="permissions-section">
          <h5>Permissions</h5>
          <div class="permissions-grid">
            <label class="checkbox-label">
              <InputCheckbox @bind-Value="newAdmin.CanManageInventory" />
              Can Manage Inventory
            </label>
            <label class="checkbox-label">
              <InputCheckbox @bind-Value="newAdmin.CanManageUsers" />
              Can Manage Users
            </label>
            <label class="checkbox-label">
              <InputCheckbox @bind-Value="newAdmin.CanViewReports" />
              Can View Reports
            </label>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-success">✅ Create Admin</button>
          <button type="button" class="btn btn-secondary" @onclick="CancelAddAdmin">❌ Cancel</button>
        </div>
      </EditForm>
    </div>
  }

  <div class="table-container">
    <table class="inv">
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Department</th>
          <th>Last Login</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var admin in adminUsers)
        {
          <tr>
            <td class="id">@admin.Id</td>
            <td><strong>@admin.Username</strong></td>
            <td>@admin.FirstName @admin.LastName</td>
            <td>@admin.Email</td>
            <td>@admin.Role</td>
            <td>@(admin.Department ?? "—")</td>
            <td>@admin.LastLoginDate.ToString("MM/dd/yyyy HH:mm")</td>
            <td>
              @if (admin.IsActive)
              {
                <span class="status-badge active">Active</span>
              }
              else
              {
                <span class="status-badge inactive">Inactive</span>
              }
            </td>
            <td>
              <div class="action-btns">
                <button class="btn-sm btn-edit" @onclick="() => StartEditAdmin(admin)">✏️</button>
                <button class="btn-sm btn-remove" @onclick="() => DeleteAdmin(admin.Id)">🗑️</button>
                <button class="btn-sm btn-toggle" @onclick="() => ToggleAdminStatus(admin.Id)">🔄</button>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
}

@if (activeTab == "gifts")
{
<div class="category-page">
  <div class="card">
    <h3>🎁 GIFTS Category</h3>
    <div class="toolbar">
      <input @bind="search" @oninput="OnSearchChanged" placeholder="🔍 Search gifts..." />
      <button class="btn btn-primary" @onclick='() => ShowAddItemForm("Gifts")'>➕ Add Gift</button>
    </div>
    @{ var giftItems = filtered.Where(i => i.Category?.Name == "Gifts").ToList(); }
    <div class="table-container">
      <table class="inv">
        <thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Cost</th><th>Stock</th><th>Actions</th></tr></thead>
        <tbody>
          @foreach (var item in giftItems)
          {
            <tr>
              <td class="id">@item.Id</td>
              <td><strong>@item.Name</strong></td>
              <td class="desc">@(item.Description ?? "—")</td>
              <td><span class="cost">@item.Cost pts</span></td>
              <td><span class="stock @(item.Stock <= 5 ? "low-stock" : "")">@item.Stock</span></td>
              <td class="actions">
                <button class="btn-sm btn-primary" @onclick="() => StartEdit(item)">✏️</button>
                <button class="btn-sm btn-danger" @onclick="() => DeleteItem(item.Id)">🗑️</button>
              </td>
            </tr>
          }
          @if (!giftItems.Any())
          {
            <tr><td colspan="7" class="no-items">🎁 No gifts found</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
}

@if (activeTab == "treats")
{
<div class="category-page">
  <div class="card">
    <h3>🍭 TREATS Category</h3>
    <div class="toolbar">
      <input @bind="search" @oninput="OnSearchChanged" placeholder="🔍 Search treats..." />
      <button class="btn btn-primary" @onclick='() => ShowAddItemForm("Treats")'>➕ Add Treat</button>
