
@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject PhilanthroPoints.Services.PointsState Points
@inject PhilanthroPoints.Services.PointsService PointsSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using PhilanthroPoints.Components.Layout
@using PhilanthroPoints.Components

<link href="/survey.css" rel="stylesheet" />
<div class="page">
  
  <main>
    <header class="topbar">
      <button class="hamburger" @onclick="ToggleMenu">☰</button>
      <span class="nav-brand" style="
  font-family: 'Feeling-Passionate', sans-serif;">
        @{/*
          Birthday connections
        */}
        <a href="/"><img src="/images/Monochrome-BDay-Connections-Logo-White.png" alt="Birthday Connections Logo" height=50px/></a>
      </span>
    </header>
    <section class="content" @onclick="CloseIfMobile">
      @Body
    </section>
    @if (!IsSpecialPage())
    {
      @if (isAuthenticated && !isAdmin)
      {
        <div class="points-floating" title="Available points for @currentUsername">
          <span>@currentPoints pts</span>
        </div>
      }
      else if (!isAuthenticated)
      {
        <!-- Login button removed as requested -->
      }
      // No points badge for admin
    }
    @if (menuOpen)
    {
        <div class="overlay" @onclick="ToggleMenu"></div>
    }
  </main>
  
  <!-- Walking characters removed -->
</div>

@code {
  private bool menuOpen;
  private int currentPoints = 0;
  private string currentUsername = "";
  private bool isAuthenticated = false;
  private bool isAdmin = false;
  [Inject] PhilanthroPoints.Services.CustomAuthStateProvider AuthProvider { get; set; } = default!;
  private bool _initialized;
  void ToggleMenu() => menuOpen = !menuOpen;
  void CloseIfMobile(){ if(menuOpen) menuOpen = false; }
  async Task HeaderLogout(){ await AuthProvider.MarkUserAsLoggedOut(); menuOpen = false; await LoadUserPoints(); }
  
  private bool IsSpecialPage()
  {
    var url = Navigation.Uri.ToLower();
    return url.Contains("/login") || url.Contains("/login-with-code") || url.Contains("/admin") || url.Contains("/register");
  }

  protected override void OnInitialized()
  {
    // Subscribe to authentication state changes
    AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    
    // Subscribe to points changes
    Points.OnPointsChanged += OnPointsChanged;
  }

  private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
  {
    await LoadUserPoints();
    await InvokeAsync(StateHasChanged);
  }

  private async void OnPointsChanged()
  {
    // Update the displayed points when PointsState changes
    currentPoints = Points.Points;
    Console.WriteLine($"[MainLayout] Points changed to: {currentPoints}");
    await InvokeAsync(StateHasChanged);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender && !_initialized)
    {
      _initialized = true;
      try
      {
        await Points.InitializeAsync();
        await Points.InitializeJavaScriptAsync();
      }
      catch (Exception ex)
      {
        Console.WriteLine($"MainLayout initialization failed: {ex.Message}");
      }
      await LoadUserPoints();
      StateHasChanged();
    }
  }

  private async Task LoadUserPoints()
  {
    try
    {
      Console.WriteLine("[MainLayout] LoadUserPoints called");
      var authState = await AuthStateProvider.GetAuthenticationStateAsync();
      var user = authState.User;
      isAuthenticated = user?.Identity?.IsAuthenticated == true;
      isAdmin = user?.IsInRole("Admin") == true;
      Console.WriteLine($"[MainLayout] IsAuthenticated: {isAuthenticated}, IsAdmin: {isAdmin}");
      if (isAuthenticated)
      {
        currentUsername = user?.Identity?.Name ?? "";
        Console.WriteLine($"[MainLayout] Username: {currentUsername}");
        var userIdClaim = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
          Console.WriteLine($"[MainLayout] User ID: {userId}");
          var member = PointsSvc.GetMember(userId);
          if (member != null)
          {
            // Use PointsState if already initialized, otherwise load from database
            if (Points.CurrentUser != null && Points.CurrentUser.Id == userId)
            {
              currentPoints = Points.Points;
              Console.WriteLine($"[MainLayout] Points loaded from PointsState: {currentPoints}");
            }
            else
            {
              currentPoints = member.Points;
              Console.WriteLine($"[MainLayout] Points loaded from database: {currentPoints}");
              // Sync with PointsState
              Points.SetUser(member);
            }
          }
          else
          {
            Console.WriteLine("[MainLayout] Member not found in database");
          }
        }
        else
        {
          Console.WriteLine("[MainLayout] No user ID claim found");
        }
      }
      else
      {
        currentPoints = 0;
        currentUsername = "";
        Console.WriteLine("[MainLayout] User not authenticated");
      }
    }
    catch (Exception ex)
    {
      Console.WriteLine($"[MainLayout] Error loading user points: {ex.Message}");
      Console.WriteLine($"[MainLayout] Stack trace: {ex.StackTrace}");
      isAuthenticated = false;
      isAdmin = false;
      currentPoints = 0;
    }
  }

  public void Dispose()
  {
    AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    Points.OnPointsChanged -= OnPointsChanged;
  }
}

<style>
/* Birthday connections Header & Navigation */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.5rem;
  gap: 12px;
  background: linear-gradient(135deg, #249EA0 0%, #FAAB36 100%);
  box-shadow: 0 4px 16px rgba(36, 158, 160, 0.3);
  border-radius: 0 0 20px 20px;
  margin-bottom: 1rem;
}

.content {
  padding: 1rem 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
}

.nav-brand {
  font-weight: 800;
  font-size: 1.5rem;
  color: white;
  font-family: 'Quicksand', sans-serif;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.badge {
  background: linear-gradient(135deg, #FFE66D, #FF8A5B);
  color: #2C3E50;
  border-radius: 20px;
  padding: 0.25rem 0.75rem;
  margin-right: 8px;
  font-weight: 600;
  font-size: 0.85rem;
}

.hamburger {
  display: none;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #249EA0;
  border: 2px solid rgba(36, 158, 160, 0.4);
  padding: 0.6rem 0.8rem;
  border-radius: 12px;
  font-size: 1.2rem;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(36, 158, 160, 0.2);
  transition: all 0.3s ease;
}

.hamburger:hover {
  background: rgba(220, 245, 245, 0.95);
  transform: scale(1.05);
  box-shadow: 0 6px 16px rgba(36, 158, 160, 0.3);
}

.login-link {
  margin-left: 12px;
  color: #249EA0;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
}

.login-link:hover {
  color: #FAAB36;
  text-decoration: underline;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(44, 62, 80, 0.7);
  z-index: 10;
  backdrop-filter: blur(4px);
}

.overlay.hidden {
  display: none;
}

/* Birthday connections Points Counter */
.points-floating {
  position: fixed;
  right: 20px;
  bottom: 100px;
  background: linear-gradient(135deg, #249EA0, #F78104);
  color: white;
  border-radius: 50px;
  padding: 0.75rem 1.25rem;
  font-weight: 700;
  font-size: 1.1rem;
  box-shadow: 
    0 8px 24px rgba(36, 158, 160, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
  z-index: 9999;
  transition: all 0.3s ease;
  border: 3px solid rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.points-floating:hover {
  transform: scale(1.05);
  box-shadow: 
    0 12px 32px rgba(36, 158, 160, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
  border-color: rgba(255, 255, 255, 0.8);
}

.points-floating span {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: 'Quicksand', sans-serif;
}

@@media (max-width: 850px) {
  .page {
    grid-template-columns: 1fr;
  }
  
  .hamburger {
    display: inline-block;
  }
  
  .nav-brand {
    font-size: 1.2rem;
  }
  
  .topbar {
    padding: 0.75rem 1rem;
  }
  
  .content {
    padding: 1rem;
  }
  
  .points-floating {
    bottom: 120px;
    right: 16px;
    padding: 0.6rem 1rem;
    font-size: 1rem;
  }
}

@@media (max-width: 600px) {
  .nav-brand {
    font-size: 1rem;
  }
  
  .points-floating {
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
  }
}

/* End of styles */
</style>
