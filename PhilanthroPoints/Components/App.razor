
@* This component is used in App.razor and configures StormBlazor authentication *@
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization

<CascadingValue Value="Points">
    <CascadingAuthenticationState>
        <Router AppAssembly="typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof(Components.Layout.MainLayout)" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(Components.Layout.MainLayout)">
                    <p>Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
</CascadingValue>

@code {
    [Inject] public PhilanthroPoints.Services.PointsState Points { get; set; } = default!;
}
