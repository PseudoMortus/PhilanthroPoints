@* Birthday Buddy - A friendly cupcake companion that guides users through the app *@
@using Microsoft.JSInterop
@inject IJSRuntime JS

<link rel="stylesheet" href="birthday-buddy.css" />

<div id="live-buddy" class="birthday-buddy timed-movement @AnimationClass">
  <div class="buddy-container">
    
    @if (Mode == "checkout")
    {
      <!-- Confetti celebration - MORE CONFETTI! -->
      <div class="confetti-container">
        @for (int i = 0; i < 25; i++)
        {
          <div class="confetti" style="left: @(Random.Shared.Next(0, 100))%; animation-delay: @(Random.Shared.Next(0, 3000))ms; animation-duration: @(Random.Shared.Next(3000, 6000))ms; background: @GetRandomColor();"></div>
        }
      </div>
    }

    <!-- The Birthday Cake Character -->
    <div class="cupcake">
      <div class="cupcake-inner">
        <!-- Cherry on top -->
        <div class="cherry"></div>
        
        <!-- Frosting with face -->
        <div class="frosting">
          <div class="sprinkles">
            <div class="sprinkle" style="left: 20%; top: 15%; background: #FF6B6B;"></div>
            <div class="sprinkle" style="left: 35%; top: 25%; background: #4ECDC4;"></div>
            <div class="sprinkle" style="left: 50%; top: 18%; background: #FFE66D;"></div>
            <div class="sprinkle" style="left: 65%; top: 28%; background: #FF8A5B;"></div>
            <div class="sprinkle" style="left: 80%; top: 20%; background: #9B59B6;"></div>
          </div>
          <div class="face">
            <div class="eyes">
              <div class="eye left-eye"></div>
              <div class="eye right-eye"></div>
            </div>
            <div class="mouth"></div>
          </div>
        </div>
        
        <!-- Cupcake wrapper -->
        <div class="wrapper">
          <div class="wrapper-ridges"></div>
        </div>
        
        <!-- Arms and Legs -->
        <div class="arm arm-left"></div>
        <div class="arm arm-right"></div>
        <div class="leg leg-left"></div>
        <div class="leg leg-right"></div>

        <!-- Plate shadow -->
        <div class="plate"></div>
      </div>
    </div>

    <!-- Message/Sign -->
    @if (!string.IsNullOrEmpty(Message))
    {
      <div class="buddy-sign @SignClass">
        <div class="sign-content">
          @if (Mode == "checkout")
          {
            <div class="celebration-text">
              <div>@Message</div>
            </div>
          }
          else if (Mode == "cards")
          {
            <span class="sign-icon">💌</span>
            <span>@Message</span>
          }
          else if (Mode == "treats")
          {
            <span class="sign-icon">🍭</span>
            <span>@Message</span>
          }
          else if (Mode == "gifts")
          {
            <span class="sign-icon">🎁</span>
            <span>@Message</span>
          }
          else
          {
            <span>@Message</span>
          }
        </div>
      </div>
    }
  </div>
</div>

@code {
  [Parameter]
  public string Mode { get; set; } = "default";

  [Parameter]
  public string? CustomMessage { get; set; }

  private string Message => CustomMessage ?? Mode switch
  {
    "login" => "Welcome!",
    "cards" => "Birthday Cards",
    "treats" => "Sweets & Treats",
    "gifts" => "Amazing Gifts",
    "checkout" => "Surprise!",
    _ => "Let's Celebrate!"
  };

  private string AnimationClass => Mode switch
  {
    "checkout" => "celebration-mode",
    "login" => "bounce-mode",
    _ => "wiggle-mode"
  };

  private string SignClass => Mode switch
  {
    "checkout" => "celebration-sign",
    _ => "holding-sign"
  };

  private string GetMouth() => Mode switch
  {
    "checkout" => "😄",
    "login" => "😊",
    _ => "😋"
  };

  private string GetRandomColor()
  {
    var colors = new[] { "#FF6B6B", "#4ECDC4", "#45B7D1", "#FFA07A", "#98D8C8", "#F7DC6F", "#BB8FCE", "#85C1E2" };
    return colors[Random.Shared.Next(colors.Length)];
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    // No JavaScript needed - using pure CSS timed animation
  }
}