@page "/"
@namespace PhilanthroPoints.Components.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Birthday Connections - Celebrate Every Special Day! 🎂</title>
    
    <!-- Optimized Font Loading with fallbacks and preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Quicksand:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
    
    <!-- Preload critical CSS -->
    <link rel="preload" href="/app.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/app.css"></noscript>
    
    <!-- Performance optimizations CSS (load after main styles) -->
    <link rel="preload" href="/app.performance.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/app.performance.css"></noscript>
  </head>
  <body>
    <app>
      <component type="typeof(App)" render-mode="Server" />
    </app>

    <script src="_framework/blazor.server.js"></script>
    
    <!-- Performance optimization script -->
    <script src="/performance.js" async></script>

    <!-- Lazy load Live2D widget after critical content loads -->
    <script>
    // Load Live2D widget asynchronously after page is fully loaded
    window.addEventListener('load', function() {
      setTimeout(function() {
        const live2dScript = document.createElement('script');
        live2dScript.src = 'https://cdn.jsdelivr.net/npm/live2d-widget@3.1.4/lib/L2Dwidget.min.js';
        live2dScript.onload = function() {
          L2Dwidget.init({
            "model": {
              "jsonPath": "https://cdn.jsdelivr.net/gh/evrstr/live2d-widget-models/live2d_evrstr/koharu/model.json"
            },
            "display": {
              "position": "right",
              "width": 85,
              "height": 200,
              "hOffset": 60,
              "vOffset": 40
            },
            "mobile": {
              "show": false, // Disable on mobile for better performance
              "scale": 0.3,
              "motion": true
            }
          });
        };
        document.head.appendChild(live2dScript);
      }, 1500); // Delay Live2D widget loading by 1.5 seconds
    });
    </script>

</body>
</html>


  